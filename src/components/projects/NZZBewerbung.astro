---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Every image on this page is a local asset, looked up by file name (the old
// Cloudinary public ID): project images, high-res originals, and the few
// page-only images in src/assets/nzz.
const pageImages = import.meta.glob<{ default: ImageMetadata }>(
  [
    "/src/assets/projects/**/*.{jpg,jpeg,png,webp}",
    "/src/assets/highres/*.{jpg,jpeg,png,webp}",
    "/src/assets/nzz/*.{jpg,jpeg,png,webp}",
  ],
  { eager: true },
);

function pageImage(id: string): ImageMetadata {
  const match = Object.entries(pageImages).find(([path]) =>
    path.slice(path.lastIndexOf("/") + 1).startsWith(`${id}.`),
  );
  if (!match) throw new Error(`NZZ page image not found: ${id}`);
  return match[1].default;
}

const mobileFlowerFiles = import.meta.glob(
  "/src/assets/projects/FlowerSplats/FlowerSplats_mobile/*.avif",
  { eager: true, query: "?url" },
);

const desktopFlowerFiles = import.meta.glob(
  "/src/assets/projects/FlowerSplats/FlowerSplats_Dekstop/*.avif",
  { eager: true, query: "?url" },
);

const mobileFlowerUrls = Object.values(mobileFlowerFiles)
  .map((mod: any) => mod.default)
  .sort()
  .reverse();

const desktopFlowerUrls = Object.values(desktopFlowerFiles)
  .map((mod: any) => mod.default)
  .sort()
  .reverse();
