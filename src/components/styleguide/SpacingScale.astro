---
const SPACING = [
  { token: "--space-1", value: "4px", note: "" },
  { token: "--space-2", value: "8px", note: "" },
  { token: "--space-3", value: "12px", note: "" },
  { token: "--space-4", value: "20px", note: "= --margin-right-tablet" },
  { token: "--space-5", value: "32px", note: "" },
  { token: "--space-6", value: "56px", note: "= desktop grid column width" },
  { token: "--space-7", value: "88px", note: "= desktop-wide grid column width" },
];

// From src/styles/global.css:84-96. The two calc() values are resolved here so
// the real number is visible rather than the expression.
const PADDING = [
  { token: "--padding-top-mobile-small", value: "80px" },
  { token: "--padding-top-mobile", value: "90px" },
  { token: "--padding-top-tablet", value: "48px" },
  { token: "--padding-top-desktop", value: "56px" },
  { token: "--padding-top-desktop-wide", value: "76px" },
  { token: "--padding-bot-mobile-small", value: "80px" },
  { token: "--padding-bot-mobile", value: "90px" },
  { token: "--padding-bot-tablet", value: "96px" },
  {
    token: "--padding-bot-desktop",
    value: "calc(9 * 56px)",
    resolved: "504px",
  },
  {
    token: "--padding-bot-desktop-wide",
    value: "calc(9 * 88px)",
    resolved: "792px",
  },
];

const RULES = [
  { label: "--border-size", css: "var(--border-size)", note: "0.5px — the token" },
  { label: "1px", css: "1px", note: "browser hairline" },
  { label: "1.5px", css: "1.5px", note: "literal used by the archive filter box" },
];
---

<h3 class="sg-subtitle">Spacing scale</h3>
<p class="sg-note">
  Added 2026-08-04, derived from values already load-bearing in this codebase
  rather than invented. Nothing outside this page consumes them yet.
</p>

<table class="sg-table">
  <thead>
    <tr>
      <th scope="col">Token</th>
      <th scope="col">Value</th>
      <th scope="col">Provenance</th>
      <th scope="col" class="sg-bar-col">Scale</th>
    </tr>
  </thead>
  <tbody>
    {
      SPACING.map((s) => (
        <tr>
          <td>
            <code class="sg-label">{s.token}</code>
          </td>
          <td class="sg-value">{s.value}</td>
          <td class="sg-value">{s.note || "—"}</td>
          <td>
            <div class="sg-bar" style={`width: var(${s.token})`} />
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<h3 class="sg-subtitle">Padding tokens</h3>
<p class="sg-note">
  Pre-existing, per-breakpoint. The two <code>calc()</code> values are resolved
  below — both are nine grid rows tall, which is why the archive and gallery
  pages scroll well past their last row.
</p>

<div class="sg-scroll">
  <table class="sg-table">
    <thead>
      <tr>
        <th scope="col">Token</th>
        <th scope="col">Declared</th>
        <th scope="col">Resolved</th>
      </tr>
    </thead>
    <tbody>
      {
        PADDING.map((p) => (
          <tr>
            <td>
              <code class="sg-label">{p.token}</code>
            </td>
            <td class="sg-value">{p.value}</td>
            <td class="sg-value">{p.resolved ?? "—"}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<h3 class="sg-subtitle">Border widths</h3>
<p class="sg-note">
  <code>--border-size</code> is <code>0.5px</code>. The declared width is not
  the used width: measured in Chromium, <strong
    >all three rules below report <code>border-top-width: 1px</code> at both DPR
    1 and DPR 2</strong
  > — 0.5px rounds up, 1.5px rounds down. Painting may still differ from that
  reported value on a high-DPR display, but nothing in CSS lets you read it back,
  so <strong>treat 0.5px, 1px and 1.5px as the same rule for layout purposes</strong>
  and confirm any intended hairline by eye on the target display. Current DPR is
  in the <a href="#breakpoints">Breakpoints</a> panel.
</p>

<div class="sg-rules">
  {
    RULES.map((r) => (
      <div class="sg-rule">
        <div class="sg-rule-meta">
          <code class="sg-label">{r.label}</code>
          <span class="sg-value">{r.note}</span>
        </div>
        <div class="sg-rule-line" style={`border-top-width: ${r.css}`} />
      </div>
    ))
  }
</div>

<style>
  @import "../../styles/global.css";

  .sg-bar-col {
    width: 40%;
  }

  .sg-rules {
    display: grid;
    gap: var(--space-4);
  }

  .sg-rule-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    padding-bottom: 6px;
  }

  .sg-rule-line {
    border-top-style: solid;
    border-top-color: var(--color-text);
  }
</style>
