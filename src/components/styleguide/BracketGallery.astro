---
import BracketOpenV from "../brackets/BracketOpenV.astro";
import BracketMiddleV from "../brackets/BracketMiddleV.astro";
import BracketCloseV from "../brackets/BracketCloseV.astro";
import Bracket from "../brackets/Bracket.astro";

// V variants are wide, short SVGs (viewBox 200x16 / 200x32) that stack as
// horizontal rules; each demo frame is sized to its own aspect ratio. The
// side-by-side brackets are the CSS-border `Bracket` component (the old
// BracketOpenH/MiddleH/CloseH SVGs were removed in Oct 2026).
const V = [
  { name: "BracketOpenV", Comp: BracketOpenV, box: "0 0 200 16", h: 16 },
  { name: "BracketMiddleV", Comp: BracketMiddleV, box: "0 -16 200 32", h: 32 },
  { name: "BracketCloseV", Comp: BracketCloseV, box: "0 -16 200 16", h: 16 },
];

const KINDS = ["open", "mid", "close"] as const;
---

<p class="sg-note">
  <code>src/components/brackets/</code> holds three V SVGs and the
  CSS-border <code>Bracket</code>. The SVGs use
  <code>vector-effect="non-scaling-stroke"</code>, so the stroke stays
  <code>1px</code> at any size; props: <code>strokewidth</code>
  (<code>"1px"</code>), <code>strokecolor</code> (<code>"black"</code>),
  <code>height</code> / <code>width</code> (<code>"100%"</code>),
  <code>overflow</code> (<code>"visible"</code>).
</p>

<h3 class="sg-subtitle">Vertical stacks (wide &amp; short)</h3>
<p class="sg-note">
  Used as horizontal rules between stacked items — the nav menu and the sort
  dropdown are built from these.
</p>
<div class="sg-bracket-list">
  {
    V.map(({ name, Comp, box, h }) => (
      <div class="sg-bracket-row">
        <div class="sg-bracket-meta">
          <code class="sg-label">{name}</code>
          <span class="sg-value">viewBox="{box}"</span>
        </div>
        <div class="sg-demo sg-bracket-frame" style={`height: ${h + 24}px`}>
          <div style={`width: 200px; height: ${h}px`}>
            <Comp />
          </div>
        </div>
      </div>
    ))
  }
</div>

<h3 class="sg-subtitle">Horizontal runs (CSS borders)</h3>
<p class="sg-note">
  <code>&lt;Bracket kind="open | mid | close" /&gt;</code> draws [, ][ and ]
  with 1px borders that stretch to fill their grid cell and snap to device
  pixels. Used beside side-by-side items, e.g. the homepage gallery bar.
</p>
<div class="sg-bracket-h-list">
  {
    KINDS.map((kind) => (
      <div class="sg-bracket-row">
        <div class="sg-bracket-meta">
          <code class="sg-label">kind="{kind}"</code>
        </div>
        <div class="sg-demo sg-bracket-frame">
          <div class="sg-bracket-cell">
            <Bracket kind={kind} />
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  @import "../../styles/global.css";

  .sg-bracket-list {
    display: grid;
    gap: var(--space-4);
  }

  /* minmax(0, 1fr), not max-content: the row's widest child is its metadata
     label ("viewBox=..."), so max-content sized each column to the text and
     overflowed the body column. The 0 minimum lets the label wrap instead. */
  .sg-bracket-h-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);

    @media (--bp-mobile) {
      grid-template-columns: 1fr;
    }
  }

  .sg-bracket-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    padding-bottom: 6px;
  }

  .sg-bracket-cell {
    display: grid;
    width: 50px;
    height: 48px;
  }

  .sg-bracket-frame {
    min-width: 0;
    overflow: hidden;
  }
</style>
