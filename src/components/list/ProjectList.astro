---
import TopWrapper from "../../layouts/TopWrapper.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { marked } from "marked";
import ImageSlide from "./ImageSlide.astro";
import "keen-slider/keen-slider.min.css";

import { getProjectMedia, sortProjectsByYear } from "./utils.ts";
import { resolveLocalImage } from "../images/localImages.ts";
import {
  formatListSummary,
  getProjectFacts,
  pickPreviewSrc,
} from "./listHelpers.ts";

const projects = await getCollection("projects");

// Sort
const sortedProjects = sortProjectsByYear(projects);

// make project keep track of its index, like this it can be used by photoswipe
let enrichedProjects = [];
let globalIndex = 0;

for (const entry of sortedProjects) {
  const projectName = entry.data.projectName;
  const startIndex = globalIndex;

  // Same list ImageSlide renders, so the PhotoSwipe indices line up.
  const media = await getProjectMedia(projectName);
  const slidesCount = media.length;
  globalIndex += slidesCount + 2;

  // Small variant for the cursor-following hover preview (shown at 220px).
  const previewPath = pickPreviewSrc(media);
  let preview: { src: string; width: number; height: number } | null = null;
  if (previewPath) {
    const source = resolveLocalImage(previewPath);
    const optimized = await getImage({ src: source, width: 440 });
    preview = {
      src: optimized.src,
      width: source.width,
      height: source.height,
    };
  }

  const projectData = {
    entry,
    projectName,
    startIndex,
    slidesCount,
    preview,
  };
  enrichedProjects.push(projectData);
}
---

<TopWrapper>
  <div id="list-wrapper">
    {
      enrichedProjects.map(({ entry, startIndex, slidesCount, preview }) => {
        const year = entry.data.year.slice(0, 4);
        const facts = getProjectFacts(entry.data);

        return (
          <Fragment>
            <div
              class:list={["ListElement"]}
              id={entry.data.projectName}
              data-project-title={entry.data.title}
              data-project-credits={entry.data.credits}
              data-preview-src={preview?.src}
              data-preview-width={preview?.width}
              data-preview-height={preview?.height}
            >
              <button
                type="button"
                class:list={["row-bar"]}
                aria-expanded="false"
                aria-controls={`${entry.data.projectName}-panel`}
              >
                <span class:list={["cell-year"]}>{year}</span>
                <span class:list={["cell-client"]}>{entry.data.client}</span>
                <span class:list={["cell-title"]}>{entry.data.title}</span>
                <span class:list={["cell-category"]}>{entry.data.role}</span>
                <span class:list={["cell-toggle"]} aria-hidden="true" />
              </button>

              <div
                class:list={["flip-out"]}
                id={`${entry.data.projectName}-panel`}
                inert
              >
                <div class:list={["project-images"]}>
                  <ImageSlide
                    projectName={entry.data.projectName}
                    startIndex={startIndex}
                    slidesCount={slidesCount}
                  />
                </div>

                <div class:list={["slider-controls"]} hidden>
                  <button
                    type="button"
                    class:list={["slider-prev"]}
                    aria-label="Previous image"
                  >
                    &larr;
                  </button>
                  <span class:list={["slider-count"]} aria-live="polite">
                    1 / {slidesCount}
                  </span>
                  <button
                    type="button"
                    class:list={["slider-next"]}
                    aria-label="Next image"
                  >
                    &rarr;
                  </button>
                </div>

                {facts.length > 0 && (
                  <dl class:list={["facts"]}>
                    {facts.map((fact) => (
                      <Fragment>
                        <dt>{fact.label}</dt>
                        <dd>{fact.value}</dd>
                      </Fragment>
                    ))}
                  </dl>
                )}

                <div class:list={["project-description"]}>
                  <div class:list={["description"]}>
                    <Fragment
                      set:html={marked.parse(entry.data.projectDescription)}
                    />
                  </div>
                </div>
              </div>
            </div>
          </Fragment>
        );
      })
    }

    <p class="list-summary">
      {formatListSummary(sortedProjects.map((p) => p.data.year))}
    </p>

    <img class="list-preview" alt="" aria-hidden="true" hidden />
  </div>
</TopWrapper>

<!-- Keen Slider -->
<script>
  import KeenSlider, { type KeenSliderInstance } from "keen-slider";
  import { shouldShowSliderControls } from "./listHelpers.ts";
  import { initListPreview } from "./preview.ts";
  import "keen-slider/keen-slider.min.css";

  type DestroyableSlider = {
    destroy: () => void;
  };

  // Store slider instances for later destruction
  let keenSlidersStore: Record<string, DestroyableSlider> = {};
  let cleanupListPreview: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    const listWrapper = document.getElementById("list-wrapper");
    cleanupListPreview?.();
    cleanupListPreview = listWrapper ? initListPreview(listWrapper) : null;

    const listElements = document.querySelectorAll<HTMLElement>(".ListElement");

    function canPlayInlineVideos() {
      return (
        document.visibilityState === "visible" &&
        document.documentElement.dataset.photoswipeOpen !== "true"
      );
    }

    function pauseVideos(root: ParentNode) {
      root.querySelectorAll("video, mux-video, mux-player").forEach((video) => {
        if ("pause" in video && typeof video.pause === "function") {
          video.pause();
        }
      });
    }

    function playAutoplayVideos(root: ParentNode) {
      root.querySelectorAll("video, mux-video, mux-player").forEach((video) => {
        const mediaLink = video.closest("a[data-media-type='video']");
        const shouldAutoplay =
          mediaLink?.getAttribute("data-mux-autoplay") === "true" ||
          video.hasAttribute("autoplay");

        if (
          shouldAutoplay &&
          "play" in video &&
          typeof video.play === "function"
        ) {
          video.play().catch(() => {});
        }
      });
    }

    function syncVisibleVideos(s: KeenSliderInstance, sliderRoot: HTMLElement) {
      pauseVideos(sliderRoot);

      if (!canPlayInlineVideos()) {
        return;
      }

      s.slides.forEach((slide, idx) => {
        const visibleAmount = s.track.details.slides[idx]?.portion ?? 0;

        if (visibleAmount > 0) {
          playAutoplayVideos(slide);
        }
      });
    }

    listElements.forEach((listEl) => {
      const sliderContainer =
        listEl.querySelector<HTMLElement>(".project-images");
      const listBar = listEl.querySelector<HTMLElement>(".row-bar");
      let sliderInView = false;
      let slider: KeenSliderInstance | null = null;

      if (!sliderContainer || !listBar) {
        return;
      }

      const inlineVisibilityObserver = new IntersectionObserver(
        ([entry]) => {
          sliderInView = Boolean(entry?.isIntersecting);

          if (!slider) {
            return;
          }

          if (sliderInView && listEl.classList.contains("open")) {
            syncVisibleVideos(slider, sliderContainer);
          } else {
            pauseVideos(sliderContainer);
          }
        },
        { threshold: 0.25 },
      );

      inlineVisibilityObserver.observe(listEl);

      document.addEventListener("portfolio:photoswipe-closed", () => {
        if (slider && sliderInView && listEl.classList.contains("open")) {
          syncVisibleVideos(slider, sliderContainer);
        }
      });

      document.addEventListener("visibilitychange", () => {
        if (
          slider &&
          sliderInView &&
          listEl.classList.contains("open") &&
          canPlayInlineVideos()
        ) {
          syncVisibleVideos(slider, sliderContainer);
        } else {
          pauseVideos(sliderContainer);
        }
      });

      const panel = listEl.querySelector<HTMLElement>(".flip-out");
      const controls = listEl.querySelector<HTMLElement>(".slider-controls");
      const prevButton =
        listEl.querySelector<HTMLButtonElement>(".slider-prev");
      const nextButton =
        listEl.querySelector<HTMLButtonElement>(".slider-next");
      const countLabel = listEl.querySelector<HTMLElement>(".slider-count");

      // Show the counter only when more slides exist than fit in view.
      function updateControls(s: KeenSliderInstance) {
        if (!controls) {
          return;
        }

        const configuredPerView = s.options.slides;
        const perView =
          typeof configuredPerView === "object" &&
          typeof configuredPerView?.perView === "number"
            ? configuredPerView.perView
            : 1;
        const total = s.slides.length;
        const current = s.track.details.rel;

        controls.hidden = !shouldShowSliderControls(total, perView);

        if (countLabel) {
          countLabel.textContent = `${current + 1} / ${total}`;
        }
        if (prevButton) {
          prevButton.disabled = current <= 0;
        }
        if (nextButton) {
          nextButton.disabled = current >= s.track.details.maxIdx;
        }
      }

      let hideTimer: ReturnType<typeof setTimeout> | undefined;

      // Click on bar
      listBar.addEventListener("click", () => {
        // Toggle the clicked slider
        if (listEl.classList.contains("open")) {
          listEl.classList.remove("open");
          listBar.setAttribute("aria-expanded", "false");
          // Closed panels must be skipped by Tab and hidden from assistive tech.
          panel?.setAttribute("inert", "");
          pauseVideos(listEl);

          // Wait out the close transition, but never undo a reopen.
          clearTimeout(hideTimer);
          hideTimer = setTimeout(() => {
            if (!listEl.classList.contains("open")) {
              sliderContainer.style.display = "";
            }
          }, 500);
        } else {
          clearTimeout(hideTimer);
          sliderContainer.style.display = "block";
          listEl.classList.add("open");
          listBar.setAttribute("aria-expanded", "true");
          panel?.removeAttribute("inert");

          // Initialize Keen Slider if not already initialized
          if (
            sliderContainer &&
            !sliderContainer.dataset.keenSliderInitialized
          ) {
            slider = new KeenSlider(sliderContainer, {
              loop: false,
              created: (s) => {
                syncVisibleVideos(s, sliderContainer);
                updateControls(s);
              },
              slideChanged: (s) => {
                syncVisibleVideos(s, sliderContainer);
                updateControls(s);
              },
              animationEnded: (s) => syncVisibleVideos(s, sliderContainer),
              optionsChanged: (s) => updateControls(s),
              slides: { perView: 4, spacing: 12 },
              breakpoints: {
                "(max-width: 1119px)": {
                  slides: { perView: 3, spacing: 12 },
                },
                "(max-width: 767px)": {
                  slides: { perView: 1.2, spacing: 12 },
                },
              },
            });

            // Store slider instance for cleanup
            keenSlidersStore[listEl.id] = slider;

            prevButton?.addEventListener("click", (e) => {
              e.stopPropagation(); // Prevent triggering the list bar click
              slider?.prev();
            });

            nextButton?.addEventListener("click", (e) => {
              e.stopPropagation(); // Prevent triggering the list bar click
              slider?.next();
            });

            sliderContainer.dataset.keenSliderInitialized = "true";
          } else if (slider && sliderInView) {
            // Re-opened: resume videos that are in view again.
            syncVisibleVideos(slider, sliderContainer);
          }
        }
      });
    });
  });

  // Clean up sliders before Astro navigates away
  document.addEventListener("astro:before-swap", () => {
    cleanupListPreview?.();
    cleanupListPreview = null;

    document
      .querySelectorAll("video, mux-video, mux-player")
      .forEach((video) => {
        if ("pause" in video && typeof video.pause === "function") {
          video.pause();
        }
      });

    Object.values(keenSlidersStore).forEach((slider) => {
      if (slider && typeof slider.destroy === "function") {
        slider.destroy();
      }
    });
    keenSlidersStore = {};
  });
</script>

<!-- PhotoSwipe -->
<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import { registerPhotoSwipeCaption } from "../gallery/photoswipeCaption";
  import {
    leftArrowSVGString,
    CloseSVGString,
    isPhonePortrait,
    buildMuxPlayerSlide,
    pauseAllVideos,
    playActivePhotoSwipeVideo,
  } from "../gallery/photoswipeVideo";

  let lightbox = null;

  document.addEventListener("astro:page-load", () => {
    const projectElements =
      document.querySelectorAll<HTMLElement>(".ListElement");

    if (projectElements.length === 0) {
      return;
    }

    let photoswipeCustomData = [];

    projectElements.forEach((projectEl) => {
      let galleryData = [];

      // Add project title slide
      const projectTitle =
        projectEl.getAttribute("data-project-title") || "Default Project Title";

      const portfolioElementNameElement = {
        html: `<div class="pswp__project-title-slide photoswipeData"><p class="pswp__project-title ">${projectTitle}</p></div>`,
      };

      galleryData.push(portfolioElementNameElement);

      // Add image elements
      const imageLinks =
        projectEl.querySelectorAll<HTMLAnchorElement>(".ImageElement a");

      imageLinks.forEach((imgLink) => {
        if (imgLink.getAttribute("data-media-type") === "video") {
          galleryData.push(buildMuxPlayerSlide(imgLink));
          return;
        }

        const photoswipeImageData = {
          src: imgLink.getAttribute("href"),
          width: imgLink.getAttribute("data-pswp-width"),
          height: imgLink.getAttribute("data-pswp-height"),
          alt: imgLink.getAttribute("data-description_text"),
          description_title: imgLink.getAttribute("data-description_title"),
          description_text: imgLink.getAttribute("data-description_text"),
          link: imgLink.getAttribute("data-link"),
        };

        galleryData.push(photoswipeImageData);
      });

      // Add project info slide
      const ProjectInfoWrapper = projectEl.querySelector<HTMLElement>(
        ".project-description",
      );
      const projectDescription = ProjectInfoWrapper
        ? ProjectInfoWrapper.innerHTML
        : "";

      const projectCredits =
        projectEl.getAttribute("data-project-credits") || "";

      const projectInfoEl = {
        html: `<div class="pswp__project-info-slide-wrapper photoswipeData keen-slider__slide">
          <div class="pswp__project-info-slide">
            <div class="pswp__project-info">
              ${projectDescription}
            </div>
            <div class="pswp__project-details">
              ${projectCredits}
            </div>
          </div>
        </div>`,
      };

      galleryData.push(projectInfoEl);
      photoswipeCustomData.push(galleryData);
    });

    const flatData = photoswipeCustomData.flat();

    const options = {
      arrowPrevSVG: leftArrowSVGString,
      arrowNextSVG: leftArrowSVGString,
      closeSVG: CloseSVGString,

      dataSource: flatData,

      initialZoomLevel: "fit" as const,
      bgOpacity: 0.95,
      zoom: false,

      mainClass: "pswp--custom-bg pswp--custom-icon-colors",

      paddingFn: () => {
        if (isPhonePortrait()) {
          return { top: 0, bottom: 0, left: 10, right: 10 };
        } else {
          return { top: 20, bottom: 40, left: 100, right: 100 };
        }
      },

      showHideAnimationType: "fade" as const,
      pswpModule: () => import("photoswipe"),
    };

    // Destroy any existing lightbox before creating a new one
    if (lightbox) {
      lightbox.destroy();
      lightbox = null;
    }

    lightbox = new PhotoSwipeLightbox(options);

    registerPhotoSwipeCaption(lightbox);
    lightbox.on("beforeOpen", () => {
      document.documentElement.dataset.photoswipeOpen = "true";
      pauseAllVideos();
    });
    lightbox.on("change", () => {
      pauseAllVideos();
      playActivePhotoSwipeVideo();
    });
    lightbox.on("close", () => {
      pauseAllVideos();
      document.documentElement.dataset.photoswipeOpen = "false";
      document.dispatchEvent(new CustomEvent("portfolio:photoswipe-closed"));
    });
    lightbox.on("destroy", () => {
      pauseAllVideos();
      document.documentElement.dataset.photoswipeOpen = "false";
      document.dispatchEvent(new CustomEvent("portfolio:photoswipe-closed"));
    });

    lightbox.init();
    window.pswpLightbox = lightbox;
  });

  // Clean up PhotoSwipe before navigation
  document.addEventListener("astro:before-swap", () => {
    pauseAllVideos();
    document.documentElement.dataset.photoswipeOpen = "false";

    if (lightbox) {
      lightbox.destroy();
      lightbox = null;
    }
  });
</script>

<style>
  @import "../../styles/global.css";

  #list-wrapper {
    --list-columns: 5rem minmax(0, 2.8fr) minmax(0, 3.6fr) minmax(0, 2.5fr)
      1.5rem;

    display: grid;
    grid-auto-rows: min-content;
    grid-column-start: 2;
    margin: 1rem 0;
    align-items: center;
    margin-top: var(--padding-desktop);
    width: 100%;

    @media (--bp-mobile) {
      --list-columns: 3.5rem 0 minmax(0, 1fr) 0 1.5rem;

      margin-top: var(--padding-mobile);
      box-sizing: border-box;
      padding-inline: 12px;
      padding-bottom: calc(var(--mobile-nav-stack) + 16px);
      grid-column-start: 1;
    }
    @media (--bp-tablet) {
      --list-columns: 5rem 0 minmax(0, 3fr) minmax(0, 2fr) 1.5rem;

      margin-top: var(--padding-tablet);
    }
    @media (--bp-desktop-wide) {
      margin-top: var(--padding-desktop-wide);
    }
  }

  .ListElement {
    display: grid;
    grid-template-columns: 1fr;
    transition: all 0.5s ease;
    /* Visible so the row band can overhang the column by 10px each side;
       the closed .flip-out clips itself (max-height 0 + overflow hidden). */
    overflow: visible;
  }

  .row-bar {
    all: unset;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: var(--list-columns);
    column-gap: 16px;
    width: calc(100% + 20px);
    margin-inline: -10px;
    padding: 7px 10px;
    min-height: 30px;
    cursor: pointer;
    font: 14px PowerGrotesk-Regular;
    color: var(--ink);
    transition:
      background-color 120ms ease,
      color 120ms ease;

    @media (--bp-mobile) {
      /* The page margin is 2px and the list adds 12px: overhang by both so
         the band still reaches the screen edge while the text sits 14px in. */
      width: calc(100% + 28px);
      margin-inline: -14px;
      padding-inline: 14px;
      min-height: 44px;
      align-items: center;
    }
  }

  .ListElement.open > .row-bar,
  .row-bar:focus-visible {
    background: var(--ink);
    color: var(--bg-color);
  }

  /* The band alone does not mark focus on open rows (already inverted) or in
     forced-colors mode, so add an inset ring inside the band. */
  .row-bar:focus-visible {
    outline: 1px solid var(--bg-color);
    outline-offset: -4px;
  }

  @media (hover: hover) {
    .row-bar:hover {
      background: var(--ink);
      color: var(--bg-color);
    }
  }

  /* Explicit columns: hiding a cell must not shift the others. */
  .cell-year {
    grid-column: 1;
  }

  .cell-client {
    grid-column: 2;

    @media (--bp-tablet) {
      display: none;
    }
    @media (--bp-mobile) {
      display: none;
    }
  }

  .cell-title {
    grid-column: 3;
  }

  .cell-category {
    grid-column: 4;

    @media (--bp-mobile) {
      display: none;
    }
  }

  .cell-toggle {
    grid-column: 5;
    justify-self: end;
    font-size: 15px;
  }

  .cell-toggle::before {
    content: "↓";
    display: inline-block;
    transition: transform 200ms ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .row-bar[aria-expanded="true"] .cell-toggle::before {
    transform: rotate(180deg);
  }

  .list-summary {
    margin-top: 32px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .list-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 220px;
    height: auto;
    object-fit: cover;
    pointer-events: none;
    z-index: 10; /* under the fixed mobile nav (z 1000) */

    @media (hover: none), (pointer: coarse) {
      display: none;
    }
  }

  .flip-out {
    grid-column: 1 / -1;
    max-height: 0;
    overflow: hidden;
    transition: all 0.5s ease;
    display: grid;
    grid-template-columns: var(--list-columns);
    column-gap: 16px;
    align-items: start;

    @media (--bp-tablet) {
      grid-template-columns: 1fr;
    }
    @media (--bp-mobile) {
      grid-template-columns: 1fr;
    }
  }

  .ListElement.open .flip-out {
    max-height: 1600px;
    overflow: visible;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
  }

  .project-images {
    display: none;
    grid-column: 1 / -1;
    margin-top: 18px;
    overflow-x: hidden;
    min-width: 0;
  }

  .slider-controls {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    font-size: 12px;
    color: var(--text-muted);
    z-index: 2; /* under the fixed mobile nav (z 1000) */
  }

  .slider-controls[hidden] {
    display: none;
  }

  .slider-prev,
  .slider-next {
    all: unset;
    cursor: pointer;
    color: var(--ink);
    padding: 4px;
  }

  .slider-prev:focus-visible,
  .slider-next:focus-visible {
    outline: 1px solid var(--ink);
  }

  .slider-prev:disabled,
  .slider-next:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .facts {
    grid-column: 1 / 3;
    display: grid;
    grid-template-columns: 5rem 1fr;
    column-gap: 16px;
    row-gap: 4px;
    margin: 28px 0 0;
    line-height: 18px;

    @media (--bp-tablet) {
      grid-column: 1 / -1;
    }
    @media (--bp-mobile) {
      grid-column: 1 / -1;
    }
  }

  .facts dt {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .facts dd {
    margin: 0;
    font-size: 13px;
    color: var(--ink);
  }

  .project-description {
    grid-column: 3 / 6;
    margin-top: 28px;
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink);

    @media (--bp-tablet) {
      grid-column: 1 / -1;
      margin-top: 24px;
    }
    @media (--bp-mobile) {
      grid-column: 1 / -1;
      margin-top: 24px;
    }
  }

  .description :global(a) {
    font-family: PowerGrotesk-Medium;
  }

  .description :global(a)::after {
    content: " ↗";
  }

  p {
    margin: 0;
  }

  :global(.pswp__video-slide) {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
  }

  :global(.pswp__video-slide mux-player),
  :global(.pswp__video-slide mux-video) {
    width: 100%;
    max-width: min(100%, 1600px);
    max-height: 100%;
    aspect-ratio: var(--video-aspect-ratio, 16 / 9);
    object-fit: contain;
    --media-object-fit: contain;
  }
</style>
