---
// One project's slider on the project index. Images and Mux videos both come
// from the local `images` collection (see getProjectMedia) and render through
// the shared MediaElement, which also emits the data-* attributes the
// project-list PhotoSwipe reads.
import "keen-slider/keen-slider.min.css";
import MediaElement from "../media/MediaElement.astro";
import { getProjectMedia } from "./utils";

interface Props {
  projectName: string;
  startIndex: number;
  slidesCount: number;
}

// Generate a unique ID for each instance
const instanceId = Math.random().toString(36).slice(2, 11);

const projectMedia = await getProjectMedia(Astro.props.projectName);
---

<div
  id={instanceId}
  data-slider-instance={instanceId}
  class:list={["image-slide keen-slider"]}
>
  {
    projectMedia.map((media, index) => {
      // Slide 0 of each project is the PhotoSwipe title slide, hence +1.
      const computedIndex = Astro.props.startIndex + 1 + index;

      return (
        <div
          class:list={["keen-slider__slide ImageElement"]}
          data-index={computedIndex}
        >
          <MediaElement
            computedIndex={computedIndex}
            media={media}
            sizes="(max-width: 767px) 80vw, (max-width: 1119px) 33vw, 25vw"
            loading={index === 0 ? "eager" : "lazy"}
          />
        </div>
      );
    })
  }
</div>

<style>
  a {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
