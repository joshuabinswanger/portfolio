---
// Renders one `stories` entry as a scrolling narrative: title + short
// description, the ordered block list, then the project facts and links. Every block is a plain object (see storyBlockSchema in
// content.config.ts), so stories are written and reordered in YAML only.
// Smooth scrolling + reveal-on-scroll live in ./scroll.ts.
import type { CollectionEntry } from "astro:content";
import { marked } from "marked";
import TopWrapper from "../../layouts/TopWrapper.astro";
import StoryImage from "./StoryImage.astro";

interface Props {
  story: CollectionEntry<"stories">;
}

const { story } = Astro.props;
const { data } = story;

const md = (text: string) => marked.parse(text) as string;

const facts = [
  ["Project", data.title],
  ["Year", data.year],
  ["Context", data.context],
  ["Client", data.client],
  ["Role", data.role],
  ["Tools", data.tools],
  ["Collaborators", data.collaborators],
].filter((row): row is [string, string] => Boolean(row[1]));

type StoryImageData = { src: string; alt: string; caption?: string };

// Scrolly blocks: give every step the index of the stage picture it shows
// (its own image, or the last one before it).
const scrollyFrames = (steps: { image?: StoryImageData }[]) => {
  const frames: StoryImageData[] = [];
  const stepFrames = steps.map((step) => {
    if (step.image) frames.push(step.image);
    return frames.length - 1;
  });
  return { frames, stepFrames };
};
---

<TopWrapper>
  <article class="story" data-story={story.id}>
    <header class="story-header" data-reveal>
      <h1>{data.title}</h1>
      {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
      {data.summary && <p class="summary">{data.summary}</p>}
    </header>

    {
      data.blocks.map((block, index) => {
        switch (block.type) {
          case "hero":
            return (
              <section class="block block-hero" data-reveal>
                <StoryImage
                  {...block.image}
                  loading={index === 0 ? "eager" : "lazy"}
                  sizes="100vw"
                />
                {block.kicker && <p class="kicker">{block.kicker}</p>}
              </section>
            );

          case "text":
            return (
              <section
                class:list={["block", "block-text", `align-${block.align ?? "left"}`]}
                data-reveal
              >
                {block.heading && <h2>{block.heading}</h2>}
                <div class="prose" set:html={md(block.body)} />
              </section>
            );

          case "image":
            return (
              <section
                class:list={["block", "block-image", `size-${block.size ?? "wide"}`]}
                data-reveal
              >
                <StoryImage
                  {...block.image}
                  sizes={
                    block.size === "narrow"
                      ? "(max-width: 767px) 100vw, 640px"
                      : "(max-width: 767px) 100vw, 952px"
                  }
                />
              </section>
            );

          case "split":
            return (
              <section
                class:list={[
                  "block",
                  "block-split",
                  `image-${block.imageSide ?? "left"}`,
                ]}
                data-reveal
              >
                <StoryImage
                  {...block.image}
                  sizes="(max-width: 767px) 100vw, 520px"
                />
                <div class="split-text">
                  {block.heading && <h2>{block.heading}</h2>}
                  <div class="prose" set:html={md(block.body)} />
                </div>
              </section>
            );

          case "gallery":
            return (
              <section
                class="block block-gallery"
                style={`--gallery-columns: ${block.columns ?? 3}`}
                data-reveal
              >
                {block.images.map((image) => (
                  <StoryImage
                    {...image}
                    sizes={`(max-width: 767px) 100vw, ${Math.round(952 / (block.columns ?? 3))}px`}
                  />
                ))}
              </section>
            );

          case "sticky":
            return (
              <section class="block block-sticky" data-sticky>
                <div class="sticky-media">
                  <StoryImage
                    {...block.image}
                    sizes="(max-width: 767px) 100vw, 520px"
                  />
                </div>
                <ol class="sticky-steps">
                  {block.steps.map((step, stepIndex) => (
                    <li
                      class:list={["sticky-step", { "is-active": stepIndex === 0 }]}
                      data-step
                    >
                      {step.heading && <h2>{step.heading}</h2>}
                      <div class="prose" set:html={md(step.body)} />
                    </li>
                  ))}
                </ol>
              </section>
            );

          case "scrolly": {
            const { frames, stepFrames } = scrollyFrames(block.steps);
            return (
              <section class="block block-scrolly" data-scrolly>
                <div class="scrolly-stage">
                  {frames.map((image, frameIndex) => (
                    <div
                      class:list={["scrolly-frame", { "is-active": frameIndex === 0 }]}
                      data-frame={frameIndex}
                    >
                      <StoryImage
                        src={image.src}
                        alt={image.alt}
                        sizes="(max-width: 767px) 100vw, 952px"
                        loading={index === 0 && frameIndex === 0 ? "eager" : "lazy"}
                      />
                    </div>
                  ))}
                </div>
                <ol class="scrolly-steps">
                  {block.steps.map((step, stepIndex) => (
                    <li
                      class:list={["scrolly-step", `pos-${step.position ?? "left"}`]}
                      data-step
                      data-frame={stepFrames[stepIndex]}
                    >
                      <div class="scrolly-card">
                        {step.heading && <h2>{step.heading}</h2>}
                        <div class="prose" set:html={md(step.body)} />
                        {step.image?.caption && (
                          <p class="scrolly-caption">{step.image.caption}</p>
                        )}
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            );
          }

          case "quote":
            return (
              <section class="block block-quote" data-reveal>
                <blockquote>
                  <p>{block.text}</p>
                  {block.source && <cite>{block.source}</cite>}
                </blockquote>
              </section>
            );

          default:
            return null;
        }
      })
    }

    <footer class="story-footer" data-reveal>
      {
        facts.length > 0 && (
          <dl class="facts">
            {facts.map(([label, value]) => (
              <div class="fact">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
            {data.links && data.links.length > 0 && (
              <div class="fact">
                <dt>Links</dt>
                <dd>
                  <ul class="links">
                    {data.links.map((link) => (
                      <li>
                        <a href={link.url} target="_blank" rel="noopener">
                          {link.label} &nearr;
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        )
      }
      <a href="/project-index/" class="back">&larr; All projects</a>
    </footer>
  </article>
</TopWrapper>

<script>
  import { initStoryScroll } from "./scroll";

  initStoryScroll();
</script>

<style>
  @import "../../styles/global.css";

  .story {
    --story-narrow: 640px;
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 10vh, 128px);
    padding-bottom: 20vh;
    font-family: PowerGrotesk-Light;
    color: black;
    min-width: 0;
  }

  /* ---------- header ---------- */

  .story-header {
    max-width: var(--story-narrow);
    margin: 0 auto;
    padding-top: 8vh;
    text-align: center;

    @media (--bp-mobile) {
      padding-top: 2vh;
    }
  }

  h1 {
    font-family: PowerGrotesk-Regular;
    font-weight: 400;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
  }

  .subtitle {
    font-size: clamp(15px, 1.6vw, 19px);
    margin: 0 0 28px;
    color: rgba(0, 0, 0, 0.6);
  }

  .summary {
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.5;
    margin: 0 auto;
    max-width: 52ch;
  }

  /* ---------- blocks ---------- */

  .block {
    min-width: 0;
  }

  h2 {
    font-family: PowerGrotesk-Regular;
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .prose {
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.6;
  }

  .prose :global(p) {
    margin: 0 0 1em;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(a) {
    color: black;
  }

  .block-hero {
    position: relative;
  }

  .kicker {
    position: absolute;
    left: 20px;
    bottom: 16px;
    margin: 0;
    padding: 6px 12px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background-color: var(--surface-glass);
    -webkit-backdrop-filter: var(--surface-blur);
    backdrop-filter: var(--surface-blur);
  }

  .block-text {
    max-width: var(--story-narrow);
    margin: 0 auto;
    width: 100%;
  }

  .block-text.align-center {
    text-align: center;
  }

  .block-image.size-narrow {
    max-width: var(--story-narrow);
    margin: 0 auto;
    width: 100%;
  }

  .block-split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;

    @media (--bp-mobile) {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .block-split.image-right :global(.story-image) {
    order: 2;

    @media (--bp-mobile) {
      order: 0;
    }
  }

  .block-gallery {
    display: grid;
    grid-template-columns: repeat(var(--gallery-columns, 3), minmax(0, 1fr));
    gap: 16px;

    @media (--bp-mobile) {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
  }

  /* Sticky story: image pins while the steps scroll past. Pure CSS sticky —
     no scroll pinning library — so it degrades to a normal stack. */
  .block-sticky {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;

    @media (--bp-mobile) {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .sticky-media {
    position: sticky;
    top: 12vh;

    @media (--bp-mobile) {
      top: 0;
      z-index: 1;
      background-color: var(--bg-color);
      padding-bottom: 12px;
    }
  }

  .sticky-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sticky-step {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 10vh 0;
    opacity: 0.3;
    transform: translateY(12px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;

    @media (--bp-mobile) {
      min-height: 40vh;
      padding: 6vh 0;
    }
  }

  .sticky-step.is-active {
    opacity: 1;
    transform: none;
  }

  /* Scrollytelling: the stage pins to the viewport (pure CSS sticky) and the
     step list is pulled up over it, so the cards slide across the picture.
     scroll.ts swaps .is-active on the frames as each step passes the middle
     of the screen. Spacers before/after give the first and last picture a
     moment on their own. */
  .block-scrolly {
    position: relative;
  }

  .scrolly-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    overflow: hidden;
  }

  .scrolly-frame {
    grid-area: 1 / 1;
    min-height: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .scrolly-frame.is-active {
    opacity: 1;
  }

  .scrolly-frame :global(.story-image),
  .scrolly-frame :global(picture) {
    height: 100%;
  }

  .scrolly-frame :global(img) {
    height: 100%;
    object-fit: contain;
  }

  .scrolly-steps {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: -100vh 0 0;
    margin-top: -100svh;
    padding: 0;
    pointer-events: none;
  }

  .scrolly-steps::before {
    content: "";
    display: block;
    height: 55svh;
  }

  .scrolly-steps::after {
    content: "";
    display: block;
    height: 45svh;
  }

  .scrolly-step {
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: 0 4%;

    @media (--bp-mobile) {
      padding: 0 12px;
    }
  }

  .scrolly-step.pos-right {
    justify-content: flex-end;
  }

  .scrolly-step.pos-center {
    justify-content: center;
  }

  /* Card: square, frosted, small shadow, like the floating bars. */
  .scrolly-card {
    pointer-events: auto;
    box-sizing: border-box;
    width: min(400px, 100%);
    padding: 20px 22px;
    background-color: var(--surface-glass);
    -webkit-backdrop-filter: var(--bar-blur);
    backdrop-filter: var(--bar-blur);
    box-shadow: var(--bar-shadow);

    @media (--bp-mobile) {
      width: 100%;
      padding: 16px 18px;
    }
  }

  .scrolly-card h2 {
    font-size: clamp(19px, 1.9vw, 24px);
    margin-bottom: 10px;
  }

  .scrolly-caption {
    margin: 12px 0 0;
    font-size: 11px;
    letter-spacing: 0.3px;
    color: rgba(0, 0, 0, 0.6);
  }

  .block-quote {
    max-width: var(--story-narrow);
    margin: 0 auto;
    width: 100%;
    text-align: center;
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    font-family: PowerGrotesk-UltraLight;
    font-weight: 100;
    font-size: clamp(22px, 3vw, 36px);
    line-height: 1.3;
    margin: 0 0 16px;
  }

  blockquote p::before {
    content: "[ ";
  }
  blockquote p::after {
    content: " ]";
  }

  cite {
    font-style: normal;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: rgba(0, 0, 0, 0.55);
  }

  /* Project facts: one ruled row per item, bracketed label, then value. */
  .story-footer {
    width: 100%;
    max-width: var(--story-narrow);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  .facts {
    width: 100%;
    margin: 0;
    border-top: var(--border-size) solid black;
  }

  .fact {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    padding: 12px 0;
    border-bottom: var(--border-size) solid black;
    font-size: 14px;

    @media (--bp-mobile) {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  .fact dt {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    padding-top: 2px;
  }

  .fact dt::before {
    content: "[ ";
  }
  .fact dt::after {
    content: " ]";
  }

  .fact dd {
    margin: 0;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    color: black;
  }

  .back {
    display: inline-block;
    padding: 10px 16px;
    background-color: black;
    color: var(--bg-color);
    text-decoration: none;
    font-size: 13px;
  }

  /* ---------- reveal on scroll (scroll.ts adds .is-visible) ---------- */

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    .sticky-step {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .sticky-step:not(.is-active) {
      opacity: 0.5;
    }
  }
</style>
