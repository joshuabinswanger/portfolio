---
import TopWrapper from "../../layouts/TopWrapper.astro";
import { getCollection } from "astro:content";
import "../../styles/global.css";

// The Links list: every links entry except "resource" ones (VSCN, socials,
// the Blender workshop, the personal site).
const links = (await getCollection("links"))
  .filter((l) => l.data.kind !== "resource")
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const services = [
  "Scientific Illustration",
  "3D Design & Visualisation",
  "Drawing & Illustration",
  "Infographics",
  "Workshops",
];

const clients = [
  "ETH",
  "Hereon @DESY",
  "University of Zurich",
  "SLF",
  "HNE Eberswalde",
  "LWF Bayern",
];
---

<TopWrapper paddingBottom="120px">
  <article id="About">
    <header class="intro">
      <p class="kicker">
        [ Rhizome (/'raɪˌzoʊm/) — an underground plant stem from which roots and
        shoots grow. ]
      </p>
      <h1>
        Joshua Binswanger is a designer and scientific illustrator, turning
        complex science into engaging images.
      </h1>
    </header>

    <div class="main">
      <div class="bio">
        <p>
          Working at the intersection of knowledge transfer and visual
          storytelling, I communicate complex information through engaging
          imagery. I thrive where I can learn, question and discuss new topics
          and combine them with my visual aesthetic and technical expertise.
        </p>
        <p>
          Alongside Rhizome Visuals, I currently work at
          <a href="https://www.augmedi.com/" rel="noopener">AugMedi</a>.
        </p>
        <p>
          Anchored by a deep fascination with the natural world, my work often
          depicts its intricacies accurately and engagingly, yet I'm drawn to
          challenging topics across the full spectrum of scientific fields.
        </p>
        <p>
          I keep sharpening my skills in art, design and technology, and share
          what I learn through courses, workshops and online platforms.
        </p>
      </div>

      <div class="facts">
        <section>
          <h2>Services</h2>
          <ul>{services.map((s) => <li>{s}</li>)}</ul>
        </section>
        <section>
          <h2>Selected clients</h2>
          <ul>{clients.map((c) => <li>{c}</li>)}</ul>
        </section>
      </div>

      <section class="contact">
        <p class="contact-text">
          For collaborations or other inquiries, write to me:
        </p>
        <!--email_off-->
        <a class="email" href="mailto:info@rhizome.ch">info@rhizome.ch</a>
        <!--/email_off-->
      </section>
    </div>

    <aside class="side">
      <nav class="links" aria-label="Links">
        <ul>
          {
            links.map((s) => (
              <li>
                <a
                  href={s.data.link}
                  rel={s.data.kind === "social" ? "me noopener" : "noopener"}
                >
                  <span class="platform">{s.data.text}</span>
                  <span class="handle">{s.data.handle}</span>
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </article>
</TopWrapper>

<style>
  @import "../../styles/global.css";

  #About {
    --about-size: var(--font-size-desktop);

    /* Headline across the top, then a wide text column (bio, services and
       clients, contact) and a thinner side column with the links. */
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    column-gap: clamp(2rem, 5vw, 6rem);
    row-gap: 3.5rem;
    max-width: 1180px;
    padding: 0 16px;
    font-size: var(--about-size);
    letter-spacing: 1px;

    @media (--bp-tablet) {
      --about-size: var(--font-size-tablet);
      grid-template-columns: minmax(0, 2fr) minmax(13rem, 1fr);
      column-gap: 2rem;
      row-gap: 2.5rem;
    }

    @media (--bp-mobile) {
      --about-size: var(--font-size-mobile);
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2.5rem;
      padding: 0 14px;
    }
  }

  h1,
  h2,
  p,
  ul {
    margin: 0;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  a {
    color: inherit;
    pointer-events: auto;
  }

  /* Small muted label above each block */
  h2 {
    font-family: PowerGrotesk-Regular;
    font-weight: 400;
    font-size: calc(var(--about-size) - 3px);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-muted);
    padding-bottom: 0.9rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .intro {
    grid-column: 1 / -1;
  }

  .kicker {
    font-family: PowerGrotesk-Light;
    font-style: italic;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  h1 {
    font-family: PowerGrotesk-Light;
    font-weight: 200;
    font-size: clamp(1.6rem, 1rem + 2.2vw, 3rem);
    line-height: 1.12;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .main {
    display: grid;
    gap: 3rem;
    align-content: start;
  }

  .bio {
    display: grid;
    gap: 1.1em;
    line-height: 1.6;

    & p:first-child {
      font-size: calc(var(--about-size) + 2px);
    }

    & a {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;

      &:hover {
        text-decoration-thickness: 2px;
      }
    }
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(1.5rem, 4vw, 4rem);
    line-height: 1.9;
  }

  .contact {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .contact-text {
    line-height: 1.6;
    margin-bottom: 0.6rem;
  }

  .email {
    font-family: PowerGrotesk-Light;
    font-size: clamp(1.25rem, 0.9rem + 1vw, 1.75rem);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;

    &:hover {
      text-decoration-thickness: 2px;
    }
  }

  /* Links: name on the first line, handle under it, arrow on the right. */
  .links {
    line-height: 1.4;

    & li {
      border-bottom: 1px solid var(--rule);
    }

    & a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1rem;
      align-items: center;
      padding: 0.6rem 0;
      text-decoration: none;
      transition: padding 200ms ease;

      &:hover,
      &:focus-visible {
        padding-left: 0.5rem;
      }

      &:hover .arrow,
      &:focus-visible .arrow {
        transform: translate(3px, -3px);
      }
    }
  }

  .platform {
    font-family: PowerGrotesk-Regular;
  }

  .handle {
    grid-column: 1;
    font-size: calc(var(--about-size) - 2px);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-family: PowerGrotesk-Light;
    transition: transform 200ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .links a {
      transition: none;
    }
  }
</style>
