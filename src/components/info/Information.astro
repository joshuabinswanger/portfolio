---
import TopWrapper from "../../layouts/TopWrapper.astro";
import { getCollection, getEntry } from "astro:content";
import "../../styles/global.css";

// Social profiles come from the links collection (kind "social").
const socials = (await getCollection("links"))
  .filter((l) => l.data.kind === "social")
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

// Entry ids are slugified file names (BlenderCourse.yaml -> "blendercourse").
const blenderCourse = await getEntry("links", "blendercourse");
if (!blenderCourse) throw new Error("links/BlenderCourse.yaml is missing");

const services = [
  "Scientific Illustration",
  "3D Design & Visualisation",
  "Drawing & Illustration",
  "Infographics",
  "Workshops",
];

const clients = [
  "ETH",
  "Hereon @DESY",
  "University of Zurich",
  "SLF",
  "HNE Eberswalde",
  "LWF Bayern",
];
---

<TopWrapper paddingBottom="120px">
  <article id="About">
    <header class="intro">
      <p class="kicker">
        [ Rhizome (/'raɪˌzoʊm/) — an underground plant stem from which roots and
        shoots grow. ]
      </p>
      <h1>
        Joshua Binswanger is a designer and scientific illustrator, turning
        complex science into engaging images.
      </h1>
    </header>

    <div class="bio">
      <p>
        Working at the intersection of knowledge transfer and visual
        storytelling, I communicate complex information through engaging
        imagery. I thrive where I can learn, question and discuss new topics and
        combine them with my visual aesthetic and technical expertise.
      </p>
      <p>
        Alongside Rhizome Visuals, I currently work at
        <a href="https://www.augmedi.com/" rel="noopener">AugMedi</a>.
      </p>
      <p>
        Anchored by a deep fascination with the natural world, my work often
        depicts its intricacies accurately and engagingly, yet I'm drawn to
        challenging topics across the full spectrum of scientific fields.
      </p>
      <p>
        I keep sharpening my skills in art, design and technology, and share
        what I learn through workshops, online platforms and my
        <a href={blenderCourse.data.link} rel="noopener"
          >Blender course at the University of Zurich</a
        >.
      </p>
    </div>

    <aside class="facts">
      <section>
        <h2>Services</h2>
        <ul>{services.map((s) => <li>{s}</li>)}</ul>
      </section>
      <section>
        <h2>Selected clients</h2>
        <ul>{clients.map((c) => <li>{c}</li>)}</ul>
      </section>
    </aside>

    <section class="project" aria-labelledby="ProjectTitle">
      <h2>Also by me</h2>
      <a class="project-card" href="https://vscn.ch" rel="noopener">
        <span class="project-name" id="ProjectTitle">
          VSCN <span class="arrow" aria-hidden="true">↗</span>
        </span>
        <span class="project-sub">Visual Science Communication Network</span>
        <span class="project-text">
          A platform where visual science communicators connect, show their work
          and find collaborators.
        </span>
        <span class="project-url">vscn.ch</span>
      </a>
    </section>

    <section class="contact">
      <h2>Get in touch</h2>
      <p class="contact-text">
        For collaborations or other inquiries, write to me:
      </p>
      <!--email_off-->
      <a class="email" href="mailto:info@rhizome.ch">info@rhizome.ch</a>
      <!--/email_off-->
    </section>

    <section class="elsewhere">
      <h2>Elsewhere</h2>
      <ul>
        {
          socials.map((s) => (
            <li>
              <a href={s.data.link} rel="me noopener">
                <span class="platform">{s.data.text}</span>
                <span class="handle">{s.data.handle}</span>
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="/personal">
            <span class="platform">Personal site</span>
            <span class="handle">rhizome.ch/personal</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </section>
  </article>
</TopWrapper>

<style>
  @import "../../styles/global.css";

  #About {
    --about-size: var(--font-size-desktop);

    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    column-gap: clamp(2rem, 5vw, 6rem);
    row-gap: 3.5rem;
    max-width: 1180px;
    padding: 0 16px;
    font-size: var(--about-size);
    letter-spacing: 1px;

    @media (--bp-tablet) {
      --about-size: var(--font-size-tablet);
      column-gap: 2rem;
      row-gap: 2.5rem;
    }

    @media (--bp-mobile) {
      --about-size: var(--font-size-mobile);
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2.5rem;
      padding: 0 14px;
    }
  }

  h1,
  h2,
  p,
  ul {
    margin: 0;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  a {
    color: inherit;
    pointer-events: auto;
  }

  /* Small muted label above each block */
  h2 {
    font-family: PowerGrotesk-Regular;
    font-weight: 400;
    font-size: calc(var(--about-size) - 3px);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-muted);
    padding-bottom: 0.9rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .intro {
    grid-column: 1 / -1;
  }

  .kicker {
    font-family: PowerGrotesk-Light;
    font-style: italic;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  h1 {
    font-family: PowerGrotesk-Light;
    font-weight: 200;
    font-size: clamp(1.6rem, 1rem + 2.2vw, 3rem);
    line-height: 1.12;
    letter-spacing: 0;
    max-width: 22ch;
    text-wrap: balance;
  }

  .bio {
    display: grid;
    gap: 1.1em;
    align-content: start;
    max-width: 62ch;
    line-height: 1.6;

    & p:first-child {
      font-size: calc(var(--about-size) + 2px);
    }
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-content: start;
    line-height: 1.9;

    @media (--bp-tablet) {
      grid-template-columns: 1fr;
    }
  }

  /* VSCN feature card: a bracketed box echoing the nav's bracket lines */
  .project {
    grid-column: 1;
    grid-row: span 2;
    align-self: start;

    @media (--bp-mobile) {
      grid-row: auto;
    }
  }

  .project-card {
    position: relative;
    display: grid;
    gap: 0.4rem;
    padding: 1.6rem 1.75rem;
    text-decoration: none;
    border-inline: 1px solid var(--ink);
    transition: background-color 200ms ease;

    &::before,
    &::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      height: 1px;
      background: linear-gradient(
        to right,
        var(--ink) 14px,
        transparent 14px calc(100% - 14px),
        var(--ink) calc(100% - 14px)
      );
    }

    &::before {
      top: 0;
    }

    &::after {
      bottom: 0;
    }

    &:hover,
    &:focus-visible {
      background-color: var(--bg-color-accent);
    }

    &:hover .arrow,
    &:focus-visible .arrow {
      transform: translate(3px, -3px);
    }
  }

  .project-name {
    font-family: PowerGrotesk-Medium;
    font-size: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    letter-spacing: 2px;
    line-height: 1;
  }

  .project-sub {
    font-family: PowerGrotesk-Regular;
  }

  .project-text {
    max-width: 52ch;
    line-height: 1.6;
    color: color-mix(in srgb, var(--ink) 75%, transparent);
  }

  .project-url {
    margin-top: 0.6rem;
    color: var(--text-muted);
  }

  .arrow {
    display: inline-block;
    font-family: PowerGrotesk-Light;
    transition: transform 200ms ease;
  }

  .contact,
  .elsewhere {
    grid-column: 2;

    @media (--bp-mobile) {
      grid-column: 1;
    }
  }

  .contact-text {
    line-height: 1.6;
    margin-bottom: 0.6rem;
  }

  .email {
    font-family: PowerGrotesk-Light;
    font-size: clamp(1.25rem, 0.9rem + 1vw, 1.75rem);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;

    &:hover {
      text-decoration-thickness: 2px;
    }
  }

  .elsewhere {
    & li {
      border-bottom: 1px solid var(--rule);
    }

    & a {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 1rem;
      padding: 0.75rem 0;
      text-decoration: none;
      transition: padding 200ms ease;

      &:hover,
      &:focus-visible {
        padding-left: 0.5rem;
      }

      &:hover .arrow,
      &:focus-visible .arrow {
        transform: translate(3px, -3px);
      }
    }
  }

  .platform {
    font-family: PowerGrotesk-Regular;
  }

  .handle {
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bio a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;

    &:hover {
      text-decoration-thickness: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .project-card,
    .elsewhere a {
      transition: none;
    }
  }
</style>
