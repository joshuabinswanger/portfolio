---
import TopWrapper from "../../layouts/TopWrapper.astro";
import GridLayout from "../../layouts/GridLayout.astro";
import ArchiveElement from "./ArchiveGalleryElement.astro";
import { getCollection } from "astro:content";
import { convertTagForCss, ensureArray, isArchiveImage } from "./utils";

// Filter the collection to include only items with metadata.archive === "include"
const archiveImages = (
  await getCollection("images", ({ data }) => {
    return data.metadata?.showInIndex === "yes";
  })
).filter(isArchiveImage);

//////////////////
///// TAGS ///////
//////////////////

// Each group: the tags present in the data, filtered against an allow-list,
// with an optional display-name remap. The CSS class (used by MixItUp's
// data-toggle) comes from convertTagForCss.

type FilterGroup = {
  id: string;
  label: string;
  options: { css: string; name: string }[];
};

function buildGroup(
  id: string,
  label: string,
  values: string[],
  allowed: string[],
  rename: Record<string, string> = {},
): FilterGroup {
  const present = Array.from(new Set(values));
  const options = allowed
    .filter((tag) => present.includes(tag))
    .map((tag) => ({ css: convertTagForCss(tag), name: rename[tag] || tag }));
  return { id, label, options };
}

const roleGroup = buildGroup(
  "role",
  "Role",
  archiveImages.flatMap((image) => ensureArray(image.data.metadata?.role)),
  ["2D", "3D", "Dev"],
  { Dev: "Tech" },
);

const programGroup = buildGroup(
  "program",
  "Tool",
  archiveImages.flatMap((image) => ensureArray(image.data.metadata?.program)),
  ["Houdini", "Blender", "ZBrush"],
  { SubstancePainter: "Substance Painter" },
);

const topicGroup = buildGroup(
  "topic",
  "Topic",
  archiveImages.flatMap((image) => [
    ...ensureArray(image.data.metadata?.topic),
    ...ensureArray(image.data.tags),
  ]),
  [
    "Science",
    "Motion",
    "Interactive",
    "Wood",
    "Character",
    "Creature",
    "Illustration",
    "Figure",
  ],
  { SciCom: "Science", Proceduralism: "Procedural" },
);

const groups = [roleGroup, programGroup, topicGroup];

const sortOptions = [
  { id: "sort-random", sort: "random", label: "Random", active: true },
  { id: "sort-project", sort: "project:asc", label: "Project", active: false },
  // Newest first.
  { id: "sort-date", sort: "date:desc", label: "Date", active: false },
];
---

<TopWrapper personal={true}>
  <div id="archive-wrapper">
    <!--
      Toolbar. Desktop: a sticky bar in the original bracket style. "Filter"
      widens and drops #filter-box below it as a bracketed drawer of option
      lists; "Sort" opens its own dropdown (#sort-menu). Active filters sit in
      the bar between brackets. Both menus lay over the grid.
      Mobile: a floating "Filter & Sort" pill and zoom pill above the nav;
      #filter-box (with its own Sort group) becomes a bottom sheet.
      Runtime: ./filters.ts.
    -->
    <form id="filter-sort-wrapper" aria-label="Filter and sort the archive">
      <button
        type="button"
        id="filter"
        class="trigger"
        aria-expanded="false"
        aria-controls="filter-box"
      >
        <span class="label-mobile">Filter &amp; Sort</span><span
          class="label-desktop">Filter</span
        ><span id="filter-count" class="count"></span><span
          class="trigger-icon"
          aria-hidden="true">&darr;</span
        >
      </button>

      <!-- Desktop only: the active filters in a bracket; each chip removes its
           filter (filled in by updateActiveFiltersList), then Clear. -->
      <div id="filter-summary">
        <span id="filter-active" class="summary-chips"></span>
        <button type="reset" id="filter-clear" class="text-button">Clear</button>
      </div>

      <div id="filter-backdrop" aria-hidden="true"></div>

      <div id="filter-box" role="group" aria-label="Filter and sort options">
        <div class="sheet-handle" aria-hidden="true"></div>

        <!-- display: contents on mobile; the clipped drawer body on desktop. -->
        <div class="box-inner">
          <div id="group-wrapper">
            {
              groups.map((group, index) => {
                // Long groups (Topic) split into two lists side by side.
                const rows =
                  group.options.length > 4
                    ? Math.ceil(group.options.length / 2)
                    : group.options.length;
                return (
                  <fieldset
                    class="filter-group"
                    id={`${group.id}-buttons-wrapper`}
                    data-filter-group={group.id}
                    style={`--card-index: ${index}`}
                  >
                    <legend class="filter-title">{group.label}</legend>
                    <div
                      class:list={["chip-row", { "two-col": rows < group.options.length }]}
                      style={`--rows: ${rows}`}
                    >
                      {group.options.map((option, i) => (
                        <button
                          type="button"
                          class:list={[
                            "filter-button",
                            "chip",
                            option.css,
                            { "col-2": i >= rows && rows < group.options.length },
                          ]}
                          data-toggle={`.${option.css}`}
                          data-filter-name={option.name}
                        >
                          {option.name}
                        </button>
                      ))}
                    </div>
                  </fieldset>
                );
              })
            }

            <!-- Sort inside the sheet is phone-only; desktop uses #sort-menu. -->
            <fieldset
              class="filter-group sort-group"
              id="sort-buttons"
              style={`--card-index: ${groups.length}`}
            >
              <legend class="filter-title">Sort</legend>
              <div class="segmented" role="group" aria-label="Sort order">
                {
                  sortOptions.map((option) => (
                    <button
                      type="button"
                      class:list={[
                        "sort-button",
                        { "mixitup-control-active": option.active },
                      ]}
                      id={option.id}
                      data-sort={option.sort}
                    >
                      {option.label}
                    </button>
                  ))
                }
              </div>
            </fieldset>
          </div>

          <div class="sheet-actions">
            <button type="reset" id="filter-reset-all" class="text-button">
              <span class="label-mobile">Reset</span><span class="label-desktop"
                >Clear</span
              >
            </button>
            <button type="button" id="filter-done" class="solid-button">
              Done
            </button>
          </div>
        </div>
      </div>

      <!-- Desktop only: Sort as its own dropdown. Its buttons are a second set
           of MixItUp sort controls; MixItUp keeps both sets' active state in
           step. The toggle shows the chosen order once one is picked. -->
      <div id="sort-menu">
        <button
          type="button"
          id="sort-toggle"
          class="trigger"
          aria-expanded="false"
          aria-controls="sort-list"
        >
          <span id="sort-label">Sort</span><span
            class="trigger-icon"
            aria-hidden="true">&darr;</span
          >
        </button>
        <div id="sort-list" role="group" aria-label="Sort order">
          <div class="sort-list-inner">
            {
              sortOptions.map((option) => (
                <button
                  type="button"
                  class:list={[
                    "sort-button",
                    "sort-option",
                    { "mixitup-control-active": option.active },
                  ]}
                  data-sort={option.sort}
                >
                  {option.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Zoom: grow/shrink the grid by one column. -->
      <div id="zoom-wrapper" class="segmented" role="group" aria-label="Grid zoom">
        <button
          type="button"
          class="zoom-button"
          id="zoom-out"
          aria-label="Zoom out: more columns, smaller images"
          title="Zoom out">&minus;</button
        >
        <button
          type="button"
          class="zoom-button"
          id="zoom-in"
          aria-label="Zoom in: fewer columns, larger images"
          title="Zoom in">+</button
        >
      </div>
    </form>

    <!-- Archive Gallery-->
    <div class:list={["container"]} id="archive">
      <GridLayout customClass={"archive-grid"}>
        {
          archiveImages.map((image, index) => (
            <ArchiveElement image={image} index={index} />
          ))
        }
      </GridLayout>
    </div>
  </div>
</TopWrapper>

<script>
  import { initArchiveFilters } from "./filters";

  initArchiveFilters();
</script>

<style>
  @import "../../styles/global.css";

  /* ------------------------------------------------------------------ */
  /* Layout                                                              */
  /* ------------------------------------------------------------------ */

  #archive-wrapper {
    display: grid;
    grid-template-rows: auto 1fr;
    padding-bottom: 11rem;

    @media (--bp-mobile) {
      grid-template-rows: 1fr;
      padding-bottom: 4rem;
    }
  }

  #archive {
    grid-row-start: 2;

    @media (--bp-mobile) {
      grid-row-start: 1;
    }
  }

  fieldset {
    border: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
  }

  /* ------------------------------------------------------------------ */
  /* Sort sections (sort by Project or Date)                            */
  /* ------------------------------------------------------------------ */

  /* Inserted into the grid by syncSortSections (filters.ts), so they are
     outside Astro's style scope. The heading takes a whole row (so the next
     section starts on a new line); its subgrid lets the title + line span
     exactly --span columns, i.e. as wide as that section's images. The line
     ends in a short down tick, the bracket motif. */
  #archive :global(.sort-heading) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding-top: 40px;
  }

  #archive :global(.sort-heading:first-child) {
    padding-top: 0;
  }

  #archive :global(.sort-heading-inner) {
    grid-column: 1 / span var(--span, 1);
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    /* Line up with the images, which sit inside the cells' padding. */
    padding: 0 var(--archive-pad, 28px);
  }

  #archive :global(.sort-heading-title) {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: PowerGrotesk-Light;
    font-size: 16px;
    letter-spacing: 0.6px;
    line-height: 1.2;
  }

  #archive :global(.sort-heading-line) {
    flex: 1 1 auto;
    min-width: 24px;
    height: 7px;
    margin-top: 7px; /* puts the rule at the title's middle */
    border-top: 1px solid black;
    border-right: 1px solid black;
  }

  /* Scroll lock while the mobile sheet is open (toggled in filters.ts). */
  :global(html.archive-sheet-open) {
    overflow: hidden;
  }

  /* ------------------------------------------------------------------ */
  /* Shared controls: chips, segmented control, buttons                 */
  /* ------------------------------------------------------------------ */

  .filter-title {
    font-family: PowerGrotesk-Light;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    margin: 0 0 5px;
    white-space: nowrap;
  }

  /* Bracket motif carried over from the old UI, now typographic. */
  .filter-title::before {
    content: "[ ";
  }
  .filter-title::after {
    content: " ]";
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  /* All controls are square, like the rest of the site (nav, brackets). */
  .chip,
  .sort-button,
  .zoom-button,
  .text-button,
  .solid-button,
  .trigger {
    font-family: PowerGrotesk-Light;
    font-size: 13px;
    letter-spacing: 0.4px;
    line-height: 1;
    color: black;
    border: 0;
    border-radius: 0;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .chip:focus-visible,
  .sort-button:focus-visible,
  .zoom-button:focus-visible,
  .text-button:focus-visible,
  .solid-button:focus-visible,
  .trigger:focus-visible {
    outline: 2px solid black;
    outline-offset: 2px;
  }

  .chip {
    height: 26px;
    padding: 0 8px;
    border: var(--border-size) solid black;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  @media (hover: hover) {
    .chip:not(:disabled):not(.mixitup-control-active):hover {
      background-color: rgba(0, 0, 0, 0.07);
    }
  }

  .chip.mixitup-control-active {
    background-color: black;
    color: var(--bg-color);
  }

  .chip:disabled,
  .chip.filter-disabled {
    opacity: 0.28;
    cursor: default;
  }

  .segmented {
    display: inline-flex;
    align-items: center;
    gap: 0;
    border: var(--border-size) solid black;
  }

  .sort-button {
    height: 26px;
    padding: 0 10px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .sort-button.mixitup-control-active {
    background-color: black;
    color: var(--bg-color);
  }

  /* Zoom: two black squares, as the original bar had them. */
  #zoom-wrapper.segmented {
    gap: 2px;
    border: 0;
  }

  .zoom-button {
    width: 26px;
    height: 26px;
    padding: 0;
    font-size: 16px;
    background-color: black;
    color: var(--bg-color);
    transition: opacity 0.2s ease;
  }

  @media (hover: hover) {
    .sort-button:not(.mixitup-control-active):hover {
      background-color: rgba(0, 0, 0, 0.07);
    }
  }

  .zoom-button:disabled {
    opacity: 0.28;
    cursor: default;
  }

  .text-button {
    height: 26px;
    padding: 0 6px;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(0, 0, 0, 0.3);
  }

  .solid-button {
    height: 36px;
    padding: 0 16px;
    background-color: black;
    color: var(--bg-color);
  }

  /* ------------------------------------------------------------------ */
  /* Desktop / tablet: bracket bar, Filter drawer, Sort dropdown         */
  /* ------------------------------------------------------------------ */

  /* Pieces that only exist on one side of the breakpoint. The desktop and
     mobile blocks below re-show the ones they need. */
  .trigger-icon,
  .label-desktop,
  #filter-summary,
  #sort-menu,
  #filter-backdrop,
  .sheet-handle,
  #filter-done {
    display: none;
  }

  /* Scoped to non-phone widths so none of it leaks into the bottom sheet.
     The look is the pre-2026-10 toolbar's: solid black blocks, and option
     lists closed off by thin brackets (a bar with legs on top, a rule with
     side ticks between rows, a bar with legs at the bottom). */
  @media (width >= 768px) {
    #filter-sort-wrapper {
      --bar-h: 32px;
      --block-w: 96px; /* closed Filter and Sort blocks */
      --ladder-w: 128px;
      --ladder-leg: 11px;
      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      /* The page's top padding, which is also where the nav sticks. */
      --bar-top: var(--padding-top-desktop);
      position: sticky;
      top: 0;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 8px;
      /* No surface: the bar is transparent and the images slide behind the
         controls. The padding is pulled up by the page's top padding so the
         controls sit level with the logo at rest and stay there while the
         page scrolls. */
      padding: var(--bar-top) 0 10px;
      margin: calc(-1 * var(--bar-top)) 0 14px;

      @media (--bp-tablet) {
        --bar-top: var(--padding-top-tablet);
      }

      @media (--bp-desktop-wide) {
        --bar-top: var(--padding-top-desktop-wide);
      }
    }

    /* The bar is invisible but spans the column, so only its controls and
       open menus take clicks; anywhere else reaches the image behind it. */
    #filter-sort-wrapper {
      pointer-events: none;
    }

    #filter,
    #filter-summary,
    #sort-menu,
    #zoom-wrapper,
    #filter-box {
      pointer-events: auto;
    }

    .label-mobile {
      display: none;
    }

    .label-desktop {
      display: inline;
    }

    /* Black blocks: Filter (widens into the drawer's header when open) and
       Sort (turns into the top of its bracket list when open). */
    #filter,
    #sort-toggle {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      box-sizing: border-box;
      height: var(--bar-h);
      padding: 0 10px;
      font-size: 14px;
      letter-spacing: 0.6px;
      background-color: black;
      color: var(--bg-color);
    }

    #filter #filter-count {
      display: none;
    }

    .trigger-icon {
      display: inline-block;
      font-size: 15px;
      transition: transform 0.3s ease;
    }

    #filter-sort-wrapper.is-open #filter .trigger-icon,
    #filter-sort-wrapper.is-sort-open #sort-toggle .trigger-icon {
      transform: rotate(180deg);
    }

    /* Opening runs in two steps, like the original: the block widens to the
       drawer's width, then the drawer drops. Closing reverses it, so the
       width transition waits while the drawer folds. --drawer-w is measured
       in filters.ts. */
    #filter {
      flex: 0 0 auto;
      width: var(--block-w);
      transition: width 0.3s ease 0.3s;
    }

    #filter-sort-wrapper.is-open #filter {
      width: var(--drawer-w, var(--block-w));
      transition: width 0.3s var(--ease-out) 0s;
    }

    /* Active filters between brackets, then Clear. Hidden while the drawer
       is open (the Filter block runs across where they sit). */
    #filter-summary {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      transition:
        opacity 0.2s ease 0.45s,
        visibility 0s linear 0.45s;
    }

    #filter-sort-wrapper.is-open #filter-summary {
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.1s ease,
        visibility 0s linear 0.1s;
    }

    .summary-chips {
      position: relative;
      display: flex;
      align-items: center;
      gap: 7px;
      box-sizing: border-box;
      height: var(--bar-h);
      padding: 0 5px;
    }

    .summary-chips:empty {
      display: none;
    }

    /* [ and ] drawn as borders, the full height of the bar. */
    .summary-chips::before,
    .summary-chips::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      width: 6px;
      box-sizing: border-box;
      border: 1.5px solid black;
    }

    .summary-chips::before {
      left: 0;
      border-right: 0;
    }

    .summary-chips::after {
      right: 0;
      border-left: 0;
    }

    /* Chips are created in filters.ts, outside Astro's style scope. */
    #filter-summary :global(.summary-chip) {
      position: relative;
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 112px;
      height: 24px;
      padding: 0 14px;
      font-family: PowerGrotesk-Light;
      font-size: 14px;
      letter-spacing: 0.6px;
      line-height: 1;
      color: var(--bg-color);
      background-color: black;
      border: 0;
      border-radius: 0;
      cursor: pointer;
      animation: summary-chip-in 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* A thin rule between chips. */
    #filter-summary :global(.summary-chip + .summary-chip::before) {
      content: "";
      position: absolute;
      left: -4px;
      top: 2px;
      bottom: 2px;
      width: 1px;
      background-color: black;
    }

    #filter-summary :global(.summary-chip:focus-visible) {
      outline: 2px solid black;
      outline-offset: 2px;
    }

    @media (hover: hover) {
      #filter-summary :global(.summary-chip:hover) {
        text-decoration: line-through;
        text-decoration-thickness: 1px;
      }
    }

    @keyframes summary-chip-in {
      from {
        opacity: 0;
        transform: translateX(-4px);
      }
    }

    #filter-clear {
      font-size: 14px;
    }

    #zoom-wrapper {
      flex: 0 0 auto;
    }

    .zoom-button {
      width: var(--bar-h);
      height: var(--bar-h);
    }

    /* ---- Option lists ("ladders") ------------------------------------ */

    /* One row per option. Each row draws its own top rule and the four
       11px side segments; stacked rows make the original bracket: legs
       under the top bar, ticks either side of each rule, legs above the
       bottom bar (the list's own border-bottom). The first background
       layer is the active fill, which sweeps in from the left. */
    .chip-row .chip,
    .sort-option {
      display: flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      width: var(--ladder-w);
      height: 32px;
      padding: 0 8px;
      font-size: 14px;
      letter-spacing: 0.6px;
      white-space: nowrap;
      color: black;
      opacity: 1;
      border: 0;
      border-top: 1px solid black;
      background-color: transparent;
      background-image:
        linear-gradient(black, black), linear-gradient(black, black),
        linear-gradient(black, black), linear-gradient(black, black),
        linear-gradient(black, black);
      background-repeat: no-repeat;
      background-position:
        left center,
        left top,
        right top,
        left bottom,
        right bottom;
      background-size:
        0% 100%,
        1px var(--ladder-leg),
        1px var(--ladder-leg),
        1px var(--ladder-leg),
        1px var(--ladder-leg);
      transition:
        background-size 0.45s ease,
        color 0.25s ease;
    }

    .chip-row .chip.mixitup-control-active,
    .sort-option.mixitup-control-active {
      color: var(--bg-color);
      background-color: transparent;
      background-size:
        100% 100%,
        1px var(--ladder-leg),
        1px var(--ladder-leg),
        1px var(--ladder-leg),
        1px var(--ladder-leg);
    }

    @media (hover: hover) {
      .chip-row .chip:not(:disabled):not(.mixitup-control-active):hover,
      .sort-option:not(.mixitup-control-active):hover {
        background-color: rgba(0, 0, 0, 0.06);
      }
    }

    /* Unavailable options fade their text only; the bracket stays whole. */
    .chip-row .chip:disabled,
    .chip-row .chip.filter-disabled {
      opacity: 1;
      color: rgba(0, 0, 0, 0.28);
    }

    .chip-row,
    .sort-list-inner {
      display: grid;
      grid-template-columns: var(--ladder-w);
      gap: 0;
      width: max-content;
      border-bottom: 1px solid black;
    }

    /* Long groups (Topic): two lists side by side sharing the middle line. */
    .chip-row.two-col {
      grid-template-columns: none;
      grid-template-rows: repeat(var(--rows), auto);
      grid-auto-flow: column;
      grid-auto-columns: var(--ladder-w);
    }

    .chip-row .col-2 {
      margin-left: -1px;
    }

    /* ---- Filter drawer ----------------------------------------------- */

    /* Hangs under the Filter block and lays over the grid. Collapsed it is a
       0fr grid row, open 1fr. */
    #filter-box {
      position: absolute;
      left: 0;
      top: calc(var(--bar-top) + var(--bar-h));
      z-index: 2;
      display: grid;
      grid-template-rows: 0fr;
      width: max-content;
      background-color: var(--bg-color);
      transition: grid-template-rows 0.3s ease 0.08s;
    }

    #filter-sort-wrapper.is-open #filter-box {
      grid-template-rows: 1fr;
      transition: grid-template-rows 0.4s var(--ease-out) 0.22s;
    }

    .box-inner {
      position: relative;
      min-height: 0;
      overflow: hidden;
    }

    /* The drawer is one big bracket: legs down from the Filter block's
       ends, and a bar with legs closing it at the bottom. */
    .box-inner::before,
    .box-inner::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      height: var(--ladder-leg);
      box-sizing: border-box;
      border: 1px solid black;
