---
import TopWrapper from "../../layouts/TopWrapper.astro";
import GridLayout from "../../layouts/GridLayout.astro";
import ArchiveElement from "./ArchiveGalleryElement.astro";
import { getCollection } from "astro:content";
import { convertTagForCss, ensureArray, isArchiveImage } from "./utils";

// Filter the collection to include only items with metadata.archive === "include"
const archiveImages = (
  await getCollection("images", ({ data }) => {
    return data.metadata?.showInIndex === "yes";
  })
).filter(isArchiveImage);

//////////////////
///// TAGS ///////
//////////////////

// Each group: the tags present in the data, filtered against an allow-list,
// with an optional display-name remap. The CSS class (used by MixItUp's
// data-toggle) comes from convertTagForCss.

type FilterGroup = {
  id: string;
  label: string;
  options: { css: string; name: string }[];
};

function buildGroup(
  id: string,
  label: string,
  values: string[],
  allowed: string[],
  rename: Record<string, string> = {},
): FilterGroup {
  const present = Array.from(new Set(values));
  const options = allowed
    .filter((tag) => present.includes(tag))
    .map((tag) => ({ css: convertTagForCss(tag), name: rename[tag] || tag }));
  return { id, label, options };
}

const roleGroup = buildGroup(
  "role",
  "Role",
  archiveImages.flatMap((image) => ensureArray(image.data.metadata?.role)),
  ["2D", "3D", "Dev"],
  { Dev: "Tech" },
);

const programGroup = buildGroup(
  "program",
  "Tool",
  archiveImages.flatMap((image) => ensureArray(image.data.metadata?.program)),
  ["Houdini", "Blender", "ZBrush"],
  { SubstancePainter: "Substance Painter" },
);

const topicGroup = buildGroup(
  "topic",
  "Topic",
  archiveImages.flatMap((image) => [
    ...ensureArray(image.data.metadata?.topic),
    ...ensureArray(image.data.tags),
  ]),
  [
    "Science",
    "Motion",
    "Interactive",
    "Wood",
    "Character",
    "Creature",
    "Illustration",
    "Figure",
  ],
  { SciCom: "Science", Proceduralism: "Procedural" },
);

const groups = [roleGroup, programGroup, topicGroup];

const sortOptions = [
  { id: "sort-random", sort: "random", label: "Random", active: true },
  { id: "sort-project", sort: "project:asc", label: "Project", active: false },
  { id: "sort-date", sort: "date:asc", label: "Date", active: false },
];
---

<TopWrapper personal={true}>
  <div id="archive-wrapper">
    <!--
      Toolbar. Desktop: a sticky rail of filter chips + segmented sort + zoom.
      Mobile: a floating "Filter & Sort" pill and zoom pill above the nav; the
      same #filter-box becomes a bottom sheet. Runtime: ./filters.ts.
    -->
    <form id="filter-sort-wrapper" aria-label="Filter and sort the archive">
      <button
        type="button"
        id="filter"
        class="trigger"
        aria-expanded="false"
        aria-controls="filter-box"
      >
        <span>Filter &amp; Sort</span><span id="filter-count" class="count"></span>
      </button>

      <div id="filter-backdrop" aria-hidden="true"></div>

      <div id="filter-box" role="group" aria-label="Filter and sort options">
        <div class="sheet-handle" aria-hidden="true"></div>

        <div id="group-wrapper">
          {
            groups.map((group) => (
              <fieldset
                class="filter-group"
                id={`${group.id}-buttons-wrapper`}
                data-filter-group={group.id}
              >
                <legend class="filter-title">{group.label}</legend>
                <div class="chip-row">
                  {group.options.map((option) => (
                    <button
                      type="button"
                      class:list={["filter-button", "chip", option.css]}
                      data-toggle={`.${option.css}`}
                      data-filter-name={option.name}
                    >
                      {option.name}
                    </button>
                  ))}
                </div>
              </fieldset>
            ))
          }

          <fieldset class="filter-group sort-group" id="sort-buttons">
            <legend class="filter-title">Sort</legend>
            <div class="segmented" role="group" aria-label="Sort order">
              {
                sortOptions.map((option) => (
                  <button
                    type="button"
                    class:list={[
                      "sort-button",
                      { "mixitup-control-active": option.active },
                    ]}
                    id={option.id}
                    data-sort={option.sort}
                  >
                    {option.label}
                  </button>
                ))
              }
            </div>
          </fieldset>
        </div>

        <div class="sheet-actions">
          <button type="reset" id="filter-reset-all" class="text-button">
            Reset
          </button>
          <button type="button" id="filter-done" class="solid-button">
            Done
          </button>
        </div>
      </div>

      <!-- Zoom: grow/shrink the grid by one column. -->
      <div id="zoom-wrapper" class="segmented" role="group" aria-label="Grid zoom">
        <button
          type="button"
          class="zoom-button"
          id="zoom-out"
          aria-label="Zoom out: more columns, smaller images"
          title="Zoom out">&minus;</button
        >
        <button
          type="button"
          class="zoom-button"
          id="zoom-in"
          aria-label="Zoom in: fewer columns, larger images"
          title="Zoom in">+</button
        >
      </div>
    </form>

    <!-- Archive Gallery-->
    <div class:list={["container"]} id="archive">
      <GridLayout customClass={"archive-grid"}>
        {
          archiveImages.map((image, index) => (
            <ArchiveElement image={image} index={index} />
          ))
        }
      </GridLayout>
    </div>
  </div>
</TopWrapper>

<script>
  import { initArchiveFilters } from "./filters";

  initArchiveFilters();
</script>

<style>
  @import "../../styles/global.css";

  /* ------------------------------------------------------------------ */
  /* Layout                                                              */
  /* ------------------------------------------------------------------ */

  #archive-wrapper {
    display: grid;
    grid-template-rows: auto 1fr;
    padding-bottom: 11rem;

    @media (--bp-mobile) {
      grid-template-rows: 1fr;
      padding-bottom: 4rem;
    }
  }

  #archive {
    grid-row-start: 2;

    @media (--bp-mobile) {
      grid-row-start: 1;
    }
  }

  fieldset {
    border: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
  }

  /* Scroll lock while the mobile sheet is open (toggled in filters.ts). */
  :global(html.archive-sheet-open) {
    overflow: hidden;
  }

  /* ------------------------------------------------------------------ */
  /* Shared controls: chips, segmented control, buttons                 */
  /* ------------------------------------------------------------------ */

  .filter-title {
    font-family: PowerGrotesk-Light;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
    margin: 0 0 8px;
    white-space: nowrap;
  }

  /* Bracket motif carried over from the old UI, now typographic. */
  .filter-title::before {
    content: "[ ";
  }
  .filter-title::after {
    content: " ]";
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip,
  .sort-button,
  .zoom-button,
  .text-button,
  .solid-button,
  .trigger {
    font-family: PowerGrotesk-Light;
    font-size: 13px;
    letter-spacing: 0.4px;
    line-height: 1;
    color: black;
    border: 0;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .chip:focus-visible,
  .sort-button:focus-visible,
  .zoom-button:focus-visible,
  .text-button:focus-visible,
  .solid-button:focus-visible,
  .trigger:focus-visible {
    outline: 2px solid black;
    outline-offset: 2px;
  }

  .chip {
    height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    border: var(--border-size) solid var(--surface-line);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }

  @media (hover: hover) {
    .chip:not(:disabled):hover {
      border-color: black;
    }
  }

  .chip.mixitup-control-active {
    background-color: black;
    border-color: black;
    color: var(--bg-color);
  }

  .chip:disabled,
  .chip.filter-disabled {
    opacity: 0.28;
    cursor: default;
  }

  .segmented {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    border: var(--border-size) solid var(--surface-line);
  }

  .sort-button,
  .zoom-button {
    height: 26px;
    padding: 0 12px;
    border-radius: 999px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .sort-button.mixitup-control-active {
    background-color: black;
    color: var(--bg-color);
  }

  .zoom-button {
    width: 34px;
    padding: 0;
    font-size: 16px;
  }

  @media (hover: hover) {
    .zoom-button:not(:disabled):hover,
    .sort-button:not(.mixitup-control-active):hover {
      background-color: rgba(0, 0, 0, 0.07);
    }
  }

  .zoom-button:disabled {
    opacity: 0.28;
    cursor: default;
  }

  .text-button {
    height: 32px;
    padding: 0 10px;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(0, 0, 0, 0.3);
  }

  .solid-button {
    height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    background-color: black;
    color: var(--bg-color);
  }

  /* ------------------------------------------------------------------ */
  /* Desktop / tablet: sticky rail                                       */
  /* ------------------------------------------------------------------ */

  #filter-sort-wrapper {
    position: sticky;
    top: 0;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: 24px;
    padding: 14px 0 14px;
    margin-bottom: 8px;
    background-color: var(--surface-glass);
    -webkit-backdrop-filter: var(--surface-blur);
    backdrop-filter: var(--surface-blur);
  }

  /* Soft fade below the rail so images slide out under it instead of
     meeting a hard edge. */
  #filter-sort-wrapper::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 18px;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--bg-color) 0%,
      rgb(from var(--bg-color) r g b / 0) 100%
    );
  }

  #filter,
  #filter-backdrop,
  .sheet-handle,
  #filter-done {
    display: none;
  }

  #filter-box {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 12px 28px;
    min-width: 0;
  }

  #group-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    min-width: 0;
    flex: 1 1 auto;
  }

  /* View controls (sort) gravitate to the right edge of their row, next to
     the zoom; the Topic row is wide enough to share with it at 952px. */
  .sort-group {
    margin-left: auto;
  }

  .sheet-actions {
    display: flex;
    align-items: center;
    align-self: end;
    margin-bottom: 1px;
  }

  /* Reset is only offered once something is selected. */
  #filter-reset-all {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  #filter-sort-wrapper:has(.filter-button.mixitup-control-active)
    #filter-reset-all {
    opacity: 1;
    pointer-events: auto;
  }

  #zoom-wrapper {
    margin-top: 22px; /* align with the chip row below the group label */
  }

  /* ------------------------------------------------------------------ */
  /* Mobile: floating pills + bottom sheet                               */
  /* ------------------------------------------------------------------ */

  @media (--bp-mobile) {
    #filter-sort-wrapper {
      position: fixed;
      top: auto;
      bottom: calc(var(--mobile-nav-stack) + 10px);
      left: var(--mobile-nav-inset);
      right: var(--mobile-nav-inset);
      z-index: 1003;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0;
      margin: 0;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      pointer-events: none;
    }

    #filter-sort-wrapper::after {
      display: none;
    }

    /* The row itself lets taps through to the grid; only the two pills and the
       sheet take them. The backdrop is deliberately NOT listed: it is a
       full-screen layer above everything, so it may only catch taps while the
       sheet is open (rule below). A blanket `> *` here once made the invisible
       backdrop swallow every tap on the page. */
    #filter,
    #zoom-wrapper,
    #filter-box {
      pointer-events: auto;
    }

    /* Trigger pill (solid) and zoom pill (glass) sit at the two ends. */
    #filter {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 44px;
      padding: 0 18px;
      border-radius: 999px;
      background-color: black;
      color: var(--bg-color);
      font-size: 14px;
      box-shadow: var(--surface-shadow);
    }

    #filter .count:not(:empty) {
      opacity: 0.7;
    }

    #zoom-wrapper {
      margin: 0;
      height: 44px;
      box-sizing: border-box;
      padding: 4px;
      background-color: var(--surface-glass);
      -webkit-backdrop-filter: var(--surface-blur);
      backdrop-filter: var(--surface-blur);
      box-shadow: var(--surface-shadow);
    }

    .zoom-button {
      height: 34px;
      width: 40px;
    }

    /* Backdrop dims the page (and the nav pill) while the sheet is up. */
    #filter-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 1100;
      background-color: rgba(0, 0, 0, 0.28);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    #filter-sort-wrapper.is-open #filter-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    #filter-sort-wrapper:not(.is-open) #filter-backdrop {
      pointer-events: none;
    }

    /* The sheet */
    #filter-box {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1101;
      display: flex;
      flex-direction: column;
      gap: 0;
      max-height: min(82dvh, 680px);
      box-sizing: border-box;
      padding: 0 20px calc(16px + env(safe-area-inset-bottom, 0px));
      border-radius: 24px 24px 0 0;
      background-color: var(--bg-color);
      box-shadow: 0 -12px 40px -16px rgba(0, 0, 0, 0.4);
      transform: translateY(100%);
      visibility: hidden;
      transition:
        transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0.42s;
    }

    #filter-sort-wrapper.is-open #filter-box {
      transform: translateY(0);
      visibility: visible;
      transition:
        transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0s;
    }

    .sheet-handle {
      display: block;
      flex: 0 0 auto;
      width: 40px;
      height: 4px;
      margin: 10px auto 6px;
      border-radius: 999px;
      background-color: rgba(0, 0, 0, 0.18);
    }

    #group-wrapper {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding: 8px 0 12px;
    }

    .filter-title {
      margin-bottom: 10px;
    }

    .chip-row {
      gap: 8px;
    }

    /* Touch-sized controls inside the sheet. */
    .chip {
      height: 40px;
      padding: 0 16px;
      font-size: 14px;
    }

    .sort-group {
      margin-left: 0;
    }

    .sort-group .segmented {
      display: flex;
      width: 100%;
      box-sizing: border-box;
    }

    .sort-button {
      flex: 1 1 0;
      height: 34px;
      font-size: 14px;
    }

    .sheet-actions {
      flex: 0 0 auto;
      align-self: stretch;
      display: flex;
      gap: 12px;
      padding-top: 12px;
      border-top: var(--border-size) solid var(--surface-line);
    }

    #filter-reset-all {
      height: 44px;
      font-size: 14px;
    }

    #filter-done {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 1 1 auto;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #filter-box,
    #filter-backdrop,
    .chip,
    .sort-button,
    .zoom-button {
      transition: none;
    }
  }
</style>
