---
import Bracket from "../brackets/Bracket.astro";
import Icon from "../Icon.astro";
import GallerySlide from "./GallerySlide.astro";

import "keen-slider/keen-slider.min.css";
import "photoswipe/style.css";
import { marked } from "marked";

// Import the utility functions
import { getGalleryData } from "./utils.ts";

interface Props {
  project: string;
  startIndex: number;
  slidesCount: number;
}

// Generate a unique ID for each instance
const instanceId = Math.random().toString(36).slice(2, 11);

// Turn Prop into string
const targetProject = Astro.props.project;

// Use the unified utility function to get all gallery data
const {
  galleryProject,
  galleryImages,
  /* highResData, hasHighRes, */ imagesAmount,
} = await getGalleryData(targetProject);

// Handle case where project is not found
if (!galleryProject) {
  throw new Error(`Gallery project "${targetProject}" not found`);
}

// Rendered once: every slide's overlay and the info slide show the same text.
const projectDescriptionHtml = await marked.parse(
  galleryProject.data.projectDescription,
);
---

<div
  id={`slider-${instanceId}`}
  class:list={"GalleryElement "}
  data-instanceId={instanceId}
  data-slidesCount={Astro.props.slidesCount}
  data-gallery-project={galleryProject.data.title}
>
  <div class:list={"SlidesContainer keen-slider"}>
    {/* Slide 0 of each gallery is the PhotoSwipe title slide, hence +1. */}
    {
      galleryImages.map((image, index) => (
        <GallerySlide
          media={image}
          index={index}
          computedIndex={Astro.props.startIndex + 1 + index}
          projectDescriptionHtml={projectDescriptionHtml}
        />
      ))
    }

    <div
      class:list={[
        "photoswipeData keen-slider__slide project-info-slide-wrapper",
      ]}
      data-index={Astro.props.startIndex + Astro.props.slidesCount + 1}
    >
      <div class:list={["project-info-slide"]}>
        <div class:list={"ProjectInfoWrapper"}>
          <p><strong>About the Project:</strong></p>
          <Fragment set:html={projectDescriptionHtml} />
        </div>

        <div class:list={"DetailsInfoWrapper"}>
          <Fragment set:html={marked.parse(galleryProject.data.credits)} />
        </div>
      </div>
    </div>
  </div>

  <div id="GalleryDescriptionWrapper">
    <Bracket kind="open" />

    <div id="TextContainer">
      <div id="TextWrapper">
        <h1>{galleryProject.data.title}</h1>
        <h2>{galleryProject.data.subtitle}</h2>
      </div>
    </div>

    <Bracket kind="mid" />

    <div id="ArrowWrapper">
      <button class:list={["ArrowLeft"]} aria-label="Previous image"
        >&larr;</button
      >
      <div class:list={"CounterContainer"}>
        1 / {imagesAmount + 1}
      </div>
      <button class:list={["ArrowRight"]} aria-label="Next image">&rarr;</button
      >
    </div>

    <Bracket kind="mid" />

    <div id="Info">
      <Icon icon="Info" width="77%" />
    </div>

    <Bracket kind="close" />
  </div>
</div>

<style>
  @import "../../styles/global.css";

  .GalleryElement {
    grid-row-start: 1;
    grid-column-start: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 3px;
    max-width: calc(100vw - 3px - 3px);
    /* overflow: hidden; */
  }

  .SlidesContainer {
    position: relative;
    width: 100%;
    height: 100%;
    box-shadow: 0px 0px 22px #988f821b;
  }

  .project-info-slide-wrapper {
    height: 100%;
    display: grid;
    place-items: center;
  }

  .project-info-slide {
    display: grid;
    font-size: var(--font-size-desktop);
    width: min(80%, 88ch);
    grid-auto-rows: auto;
    align-items: center;
    overflow-x: hidden;

    @media (--bp-mobile) {
      font-size: var(--font-size-mobile);
    }

    @media (--bp-tablet) {
      font-size: var(--font-size-tablet);
    }

    @media (--bp-desktop-wide) {
      font-size: var(--font-size-desktop-wide);
    }
  }

  .ProjectInfoWrapper,
  .DetailsInfoWrapper {
    width: 80%; /* Ensure it takes full width */
    justify-self: center; /* Centers items horizontally */
    margin-top: 0px;
    margin-bottom: 0px;

    span {
      font-family: PowerGrotesk-Medium;
    }

    @media (--bp-mobile) {
      width: 85%;
    }
  }

  .DetailsInfoWrapper {
    margin-top: 24px;
    padding-bottom: 0.5rem;
  }

  /* Image Element */
  /* .ImageElement {
  min-width: 100%;
}


 */

  /*  .Slide {
min-width: 80vw !important;
max-width: 80vw !important;
} */
  /* GalleryDescription */

  #GalleryDescriptionWrapper {
    display: grid;
    width: 100%;
    max-width: calc(100vw - 3px - 3px);
    overflow: visible;
    opacity: 1;
    height: fit-content;
    /* The brackets stretch to this row height; 56px is the bar's established
       look (the old SVG brackets sized it implicitly). */
    min-height: 56px;
    grid-template-columns:
      1.5ch minmax(min-content, 2fr) 3ch minmax(7ch, 1.5fr)
      3ch 3.5ch 1.5ch;
    justify-content: center;
    align-items: center;
    transition: opacity 1.5s ease-in;

    /* A slimmer bar to match the smaller nav buttons on desktop. */
    @media (--bp-desktop), (--bp-desktop-wide) {
      min-height: 48px;
    }
  }

  #ArrowWrapper {
    display: grid;
    width: 100%;
    grid-template-columns: auto min-content auto;
    place-items: center;
    z-index: 2; /* see .ImageInfo */
  }

  button {
    all: unset;
    text-justify: center;
    text-align: center;
    width: stretch;
    cursor: pointer;
    padding: 0.5rem 0.5%;
  }

  .CounterContainer {
    text-align: center;
    width: 5ch;
    font-size: var(--font-size-desktop-h1);
    font-family: PowerGrotesk-Regular;
    font-weight: 400;
    padding: 0.5rem 0.5%;

    @media (--bp-mobile) {
      font-size: var(--font-size-mobile-h1);
    }

    @media (--bp-tablet) {
      font-size: var(--font-size-tablet-h1);
    }

    @media (--bp-desktop-wide) {
      font-size: var(--font-size-desktop-wide-h1);
    }
  }

  /* Text Elements */
  #TextContainer {
    cursor: pointer;
    width: auto;
    max-width: 40vw;
    overflow-x: hidden;
    display: grid;
    place-items: center;
  }

  h1 {
    font-family: PowerGrotesk-Regular;
    font-weight: 400;
    font-size: var(--font-size-desktop-h1);
    letter-spacing: 0.7px;
    margin: 0px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    @media (--bp-mobile) {
      font-size: var(--font-size-mobile-h1);
    }

    @media (--bp-tablet) {
      font-size: var(--font-size-tablet-h1);
    }

    @media (--bp-desktop-wide) {
      font-size: var(--font-size-desktop-wide-h1);
    }
  }

  h2 {
    font-family: PowerGrotesk-Light;
    font-weight: 200;
    font-size: var(--font-size-desktop);
    letter-spacing: 0.5px;
    margin: 0px;

    @media (--bp-mobile) {
      font-size: var(--font-size-mobile);
    }

    @media (--bp-tablet) {
      font-size: var(--font-size-tablet);
    }

    @media (--bp-desktop-wide) {
      font-size: var(--font-size-desktop-wide);
    }
  }

  #Info {
    display: grid;
    place-items: center;
    cursor: pointer; /* Ensure it looks clickable */
    pointer-events: auto;
    margin: 0 -5px;
  }
</style>
