---
// One media slide of a homepage gallery: the image or video (through the
// shared MediaElement) plus the description overlay that the #Info button
// toggles. PortfolioGallery's script finds these by class: .ImageElement
// (lazy reveal, PhotoSwipe links) and .ImageInfo (toggles .InfoVisible), so
// keep those class names and their styles here.
import type { CollectionEntry } from "astro:content";
import MediaElement from "../media/MediaElement.astro";

interface Props {
  media: CollectionEntry<"images">;
  index: number;
  computedIndex: number;
  // Already rendered from markdown by GalleryElement, once per gallery.
  projectDescriptionHtml: string;
}

const { media, index, computedIndex, projectDescriptionHtml } = Astro.props;
const metadata = media.data.metadata;
---

<div class:list={["keen-slider__slide Slide"]} data-index={computedIndex}>
  <div class:list={"ImageInfo"}>
    <div class:list={"ImageDescriptionWrapper"}>
      <div class:list={"image-description"}>
        {
          metadata && (
            <>
              <p>
                <strong>{metadata.description_title}</strong>
              </p>
              <p>{metadata.description_text}</p>
            </>
          )
        }
      </div>

      <hr />

      <div class:list={["image-info-project"]}>
        <div class:list={"ProjectInfoWrapper"}>
          <p>
            <strong>About the Project:</strong>
          </p>
          <Fragment set:html={projectDescriptionHtml} />
        </div>
      </div>
    </div>
  </div>

  <div class:list={"Filter"}></div>

  <div class:list={["ImageElement"]} style={index > 1 ? "display: none;" : ""}>
    {
      /*        TODO: restore highRes lightbox data
      href={highResData[index].highResSecureUrl}
      data-pswp-width={highResData[index].highResWidth}
      data-pswp-height={highResData[index].highResHeight}
      */
    }

    <MediaElement
      computedIndex={computedIndex}
      media={media}
      sizes="(max-width: 767px) 85vw, (max-width: 1119px) 50vw, (max-width: 1699px) 33vw, 25vw"
      loading={index === 0 ? "eager" : "lazy"}
    />
  </div>
</div>

<style>
  @import "../../styles/global.css";

  .ImageElement :global(a),
  .ImageElement :global(picture) {
    display: block;
    width: 100%;
    height: auto;
  }

  .ImageElement :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    vertical-align: top;
  }

  .ImageElement :global(mux-video) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
  }

  .Filter {
    position: absolute;
    top: 0;
    left: 0;
    background-color: #fbf9f400;
    width: 100%;
    height: 100%;
    /* No idle backdrop-filter here (or on .ImageInfo): an always-on
       blur(0px) layer per slide kept iOS Safari from blurring the gallery
       under the floating nav bar. */
    z-index: 11;
    transition: background-color ease-in-out 0.2s;
    pointer-events: none;
  }

  /*   Image Info */

  .ImageInfo {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    display: grid;
    justify-items: center;
    align-items: center;

    pointer-events: none; /* Prevent interaction with the description if needed */
    background-color: var(--bg-color-trans); /* Example style */

    /* No blur until .InfoVisible (see .Filter) */
    backdrop-filter: none;

    /* Add transition for backdrop-filter */
    transition:
      backdrop-filter ease-in-out 0.3s,
      opacity 0.3s ease-in-out;

    font-size: var(--font-size-desktop);
    hyphens: auto;

    overflow: auto;

    /* Above .Filter (11). Keep below the fixed mobile nav (z 1000): at 1111
       the overlay and the arrows painted over the bar. */
    z-index: 12;

    @media (--bp-mobile) {
      font-size: var(--font-size-mobile);
    }

    @media (--bp-tablet) {
      font-size: var(--font-size-tablet);
    }

    @media (--bp-desktop-wide) {
      font-size: var(--font-size-desktop-wide);
      line-height: 1.33;
    }
  }

  .ImageDescriptionWrapper {
    display: grid;
    width: min(88%, 66ch);
    grid-template-rows: min-content min-content min-content;
    align-items: center;
    align-content: space-around;
  }

  hr {
    width: 80%;
    align-self: center;
    border-style: unset;
    border-top: 1px solid;
    border-color: black;
    margin-block: unset;
    margin-inline: unset;
    margin: 24px auto;

    @media (--bp-mobile) {
      display: none;
    }
  }

  .image-info-project {
    margin-top: 10px;

    @media (--bp-mobile) {
      display: none;
    }
  }

  .InfoVisible {
    opacity: 1;
    backdrop-filter: blur(22px);
    transition:
      opacity 0.3s,
      backdrop-filter 0.3s ease;
  }

  .image-description,
  .ProjectInfoWrapper {
    width: 80%; /* Ensure it takes full width */
    justify-self: center; /* Centers items horizontally */
    margin-top: 0px;
    margin-bottom: 0px;

    span {
      font-family: PowerGrotesk-Medium;
    }

    @media (--bp-mobile) {
      width: 85%;
    }
  }
</style>
