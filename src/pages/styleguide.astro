---
// Internal design-system reference. Unlisted: not linked from any nav
// component, noindex via Main.astro, and filtered out of the sitemap in
// astro.config.mjs. See docs/design-system.md.
import Main from "../layouts/Main.astro";
import Section from "../components/styleguide/Section.astro";
import BreakpointReadout from "../components/styleguide/BreakpointReadout.astro";
import ColorSwatches from "../components/styleguide/ColorSwatches.astro";
import TypeSpecimens from "../components/styleguide/TypeSpecimens.astro";
import SpacingScale from "../components/styleguide/SpacingScale.astro";
import GridOverlay from "../components/styleguide/GridOverlay.astro";
import "../styles/styleguide.css";

// Section ids are the contract between this ToC and the <Section> calls below.
const SECTIONS = [
  { id: "breakpoints", title: "Breakpoints" },
  { id: "color", title: "Colour" },
  { id: "type", title: "Type" },
  { id: "spacing", title: "Spacing & Border" },
  { id: "grid", title: "Grid" },
  { id: "brackets", title: "Brackets" },
  { id: "icons", title: "Icons" },
  { id: "chrome", title: "Chrome" },
];
---

<Main
  title="Design System — Rhizome Visuals (internal)"
  description="Internal reference rendering the design tokens and UI primitives of rhizome.ch."
  noindex={true}
>
  <div class="sg-page">
    <header class="sg-header">
      <h1 class="sg-title">Design System</h1>
      <p class="sg-lede">
        Internal reference for rhizome.ch. Every token below is read from
        <code>src/styles/global.css</code> at render time — resize the window to
        watch the per-breakpoint values change. Not linked, not indexed.
      </p>
    </header>

    <div class="sg-layout">
      <nav class="sg-toc" aria-label="Design system sections">
        {
          SECTIONS.map((s) => (
            <a href={`#${s.id}`}>{s.title}</a>
          ))
        }
      </nav>

      <main class="sg-body" id="main">
        <Section
          id="breakpoints"
          title="Breakpoints"
          note="Measured live, not hardcoded. The grid values come from a hidden probe carrying the same rules as <code>.grid-container</code> in <code>src/layouts/GridLayout.astro</code>. Note that <code>--bp-mobile-small</code> is a subset of <code>--bp-mobile</code>, so both match at once below 376px."
        >
          <BreakpointReadout />
        </Section>
        <Section id="color" title="Colour">
          <ColorSwatches />
        </Section>
        <Section id="type" title="Type">
          <TypeSpecimens />
        </Section>
        <Section id="spacing" title="Spacing & Border">
          <SpacingScale />
        </Section>
        <Section id="grid" title="Grid">
          <GridOverlay />
        </Section>
        <Section id="brackets" title="Brackets" />
        <Section id="icons" title="Icons" />
        <Section id="chrome" title="Chrome" />
      </main>
    </div>
  </div>
</Main>
